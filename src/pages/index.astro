---
import { actorDid } from "@/lib/const";
import Hero from "@/components/landing/Hero.astro";
import Intro from "@/components/landing/Intro.astro";
import BuildingStory from "@/components/landing/stories/BuildingStory.astro";
import ListeningStory from "@/components/landing/stories/ListeningStory.astro";
import MeetingStory from "@/components/landing/stories/MeetingStory.astro";
import ReadingStory from "@/components/landing/stories/ReadingStory.astro";
import SocialStory from "@/components/landing/stories/SocialStory.astro";
import WorkingStory from "@/components/landing/stories/WorkingStory.astro";
import WritingStory from "@/components/landing/stories/WritingStory.astro";
import StorySkeleton from "@/components/story/StorySkeleton.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Felix Schneider">
  <noscript>
    <style>
      .story-frame .story-copy > *,
      .story-frame .story-visual,
      .story-frame > .story-skeleton {
        opacity: 1 !important;
        translate: none !important;
        filter: none !important;
      }
    </style>
  </noscript>
  <Hero name="Felix Schneider" />

  <div class="content-wrapper layout-stream">
    <Intro />

    <div class="stories" data-stories>
      <div class="stories-stage">
        <WritingStory server:defer>
          <StorySkeleton
            slot="fallback"
            kicker="Writing"
            href="/blog"
            linkText="Read the blog"
            title={[{ bone: "33" }, " posts, mostly notes to my future self"]}
            text={[
              [
                "Recipes, small fixes I don't want to look up twice, and the odd longer thought.",
              ],
              ["Every dot is a post. Pick one."],
            ]}
            visual={368 / 448}
          />
        </WritingStory>
        <BuildingStory />
        <ReadingStory server:defer>
          <StorySkeleton
            slot="fallback"
            kicker="Reading"
            href="/books"
            linkText="Browse the bookshelf"
            title={[{ bone: "30" }, " books, mostly fantasy"]}
            text={[
              ["Right now I'm reading ", { bone: "a book with a title" }, "."],
              ["Lately a lot of ", { bone: "an author" }, ", apparently."],
            ]}
            visual={368 / 167}
          />
        </ReadingStory>
        <ListeningStory server:defer>
          <StorySkeleton
            slot="fallback"
            kicker="Listening"
            href="/music"
            linkText="Dig into my music"
            title={[{ bone: "1,000" }, " plays and counting"]}
            text={[
              [
                "Unusual taste, I know. ",
                { bone: "Lately it's mostly a few artists and another one." },
              ],
            ]}
            visual={368 / 158}
          />
        </ListeningStory>
        <WorkingStory server:defer>
          <StorySkeleton
            slot="fallback"
            kicker="Working"
            href="/resume"
            linkText="Read the resume"
            title={["Shipping software since ", { bone: "2019" }]}
            text={[
              [
                {
                  bone: "A job title at a company, studying a field at a school.",
                },
              ],
            ]}
            visual={368 / 316}
          />
        </WorkingStory>
        <MeetingStory server:defer />
        <SocialStory server:defer>
          <StorySkeleton
            slot="fallback"
            kicker="Hanging out"
            href={`https://bsky.app/profile/${actorDid}`}
            linkText="Find me on Bluesky"
            title={["Mostly ", { bone: "posting" }]}
            text={[
              [
                "What I actually do on Bluesky, GitHub and Tangled, from posts and replies to stars and follows.",
              ],
            ]}
            visual={368 / 333}
          />
        </SocialStory>
      </div>
    </div>
  </div>
</Layout>

<script>
  import "@/scripts/now-playing";
  import "@/scripts/stories";
</script>

<style>
  .layout-stream {
    position: relative;
    z-index: 10;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .stories {
    position: relative;
  }

  .stories-stage {
    display: flex;
    flex-direction: column;
  }

  /* On wide screens the sections share one stage pinned to the screen, like
     slides: the page scrolls past it, and the section that matches the
     scroll position plays in while the one before plays out. This applies
     before the script runs, so the page never shows every section at once. */
  @media (min-width: 860px) and (min-height: 620px) and (prefers-reduced-motion: no-preference) {
    :global(html:has(.stories)) {
      scroll-snap-type: y proximity;
    }

    .stories {
      height: calc(var(--count, 7) * 85svh + 100svh);
    }

    .stories-stage {
      position: sticky;
      top: 0;
      display: grid;
      height: 100svh;
      translate: 0 var(--stage-shift, 0px);
    }

    .stories-stage > :global(*) {
      grid-area: 1 / 1;
      min-width: 0;
    }

    .stories :global(.story-frame) {
      display: grid;
      align-items: center;
      padding-top: 72px;
    }

    .stories :global(.story-frame > *) {
      padding-block: 0;
      min-height: 0;
    }

    .stories :global(.story-frame:not([data-active="true"])) {
      pointer-events: none;
    }

    /* Where scroll timelines work, the stage glides in and out on the
       compositor, in step with the scrolling and with its own pinning, so it
       never lags a frame behind. The script moves it everywhere else. The
       stops trace the script's curve: it follows the page right after the
       intro, slows down into the middle and speeds up again at the end. */
    @supports (animation-timeline: view()) {
      .stories {
        view-timeline: --stories block;
      }

      .stories-stage {
        translate: none;
        animation:
          stage-enter linear both,
          stage-leave linear both;
      }

      /* Separate on purpose, see the parallax in `Hero.astro`: a minifier
         would fold these into the shorthand above, which browsers reject. */
      .stories-stage.stories-stage {
        animation-timeline: --stories, --stories;
        animation-range:
          entry 0% contain 7svh,
          exit -7svh exit 100%;
        animation-composition: replace, add;
      }

      @keyframes stage-enter {
        0.0% {
          translate: 0 -18svh;
        }
        53.27% {
          translate: 0 -18svh;
        }
        56.19% {
          translate: 0 -17.9svh;
        }
        59.11% {
          translate: 0 -17.61svh;
        }
        62.03% {
          translate: 0 -17.12svh;
        }
        64.95% {
          translate: 0 -16.44svh;
        }
        67.87% {
          translate: 0 -15.56svh;
        }
        70.79% {
          translate: 0 -14.48svh;
        }
        73.71% {
          translate: 0 -13.21svh;
        }
        76.64% {
          translate: 0 -11.75svh;
        }
        79.56% {
          translate: 0 -10.09svh;
        }
        82.48% {
          translate: 0 -8.23svh;
        }
        85.4% {
          translate: 0 -6.18svh;
        }
        88.32% {
          translate: 0 -3.94svh;
        }
        91.24% {
          translate: 0 -1.5svh;
        }
        93.46% {
          translate: 0 0.49svh;
        }
        94.16% {
          translate: 0 0.39svh;
        }
        97.08% {
          translate: 0 0.1svh;
        }
        100.0% {
          translate: 0 0svh;
        }
      }
      @keyframes stage-leave {
        0.0% {
          translate: 0 0svh;
        }
        2.92% {
          translate: 0 -0.1svh;
        }
        5.84% {
          translate: 0 -0.39svh;
        }
        6.54% {
          translate: 0 -0.49svh;
        }
        8.76% {
          translate: 0 1.5svh;
        }
        11.68% {
          translate: 0 3.94svh;
        }
        14.6% {
          translate: 0 6.18svh;
        }
        17.52% {
          translate: 0 8.23svh;
        }
        20.44% {
          translate: 0 10.09svh;
        }
        23.36% {
          translate: 0 11.75svh;
        }
        26.29% {
          translate: 0 13.21svh;
        }
        29.21% {
          translate: 0 14.48svh;
        }
        32.13% {
          translate: 0 15.56svh;
        }
        35.05% {
          translate: 0 16.44svh;
        }
        37.97% {
          translate: 0 17.12svh;
        }
        40.89% {
          translate: 0 17.61svh;
        }
        43.81% {
          translate: 0 17.9svh;
        }
        46.73% {
          translate: 0 18svh;
        }
        100.0% {
          translate: 0 18svh;
        }
      }
    }

    .stories :global(.stories-snap) {
      position: absolute;
      top: calc((var(--i) + 0.5) * 85svh);
      left: 0;
      width: 1px;
      height: 1px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      pointer-events: none;
    }
  }

  /* A section still loading never shows through the one on stage. */
  @media (prefers-reduced-motion: no-preference) {
    .stories :global(.story-frame > .story-skeleton) {
      transition: opacity 0.4s ease;
    }

    .stories :global(.story-frame:not([data-active="true"]) > .story-skeleton) {
      opacity: 0;
    }
  }
</style>
