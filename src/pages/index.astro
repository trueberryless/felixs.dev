---
import Hero from "@/components/landing/Hero.astro";
import Intro from "@/components/landing/Intro.astro";
import BuildingStory from "@/components/landing/stories/BuildingStory.astro";
import ListeningStory from "@/components/landing/stories/ListeningStory.astro";
import MeetingStory from "@/components/landing/stories/MeetingStory.astro";
import ReadingStory from "@/components/landing/stories/ReadingStory.astro";
import SocialStory from "@/components/landing/stories/SocialStory.astro";
import WorkingStory from "@/components/landing/stories/WorkingStory.astro";
import WritingStory from "@/components/landing/stories/WritingStory.astro";
import StorySkeleton from "@/components/story/StorySkeleton.astro";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Felix Schneider">
  <Hero name="Felix Schneider" />

  <div class="content-wrapper layout-stream">
    <Intro />

    <div class="stories">
      <WritingStory server:defer>
        <StorySkeleton slot="fallback" />
      </WritingStory>
      <BuildingStory />
      <ReadingStory server:defer>
        <StorySkeleton slot="fallback" />
      </ReadingStory>
      <ListeningStory server:defer>
        <StorySkeleton slot="fallback" />
      </ListeningStory>
      <WorkingStory server:defer>
        <StorySkeleton slot="fallback" />
      </WorkingStory>
      <MeetingStory server:defer />
      <SocialStory server:defer>
        <StorySkeleton slot="fallback" />
      </SocialStory>
    </div>
  </div>
</Layout>

<script>
  import "@/scripts/now-playing";
</script>

<style>
  .layout-stream {
    position: relative;
    z-index: 10;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .stories {
    display: flex;
    flex-direction: column;
  }
</style>
