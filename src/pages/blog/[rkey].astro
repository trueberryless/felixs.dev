---
import Blocks from "@/components/blog/post/Blocks.astro";
import ExternalIcon from "@/components/utils/ExternalIcon.astro";
import PostImage from "@/components/blog/post/PostImage.astro";
import type { EmbeddedPost } from "@/components/blog/post/BskyEmbed.astro";
import LayoutPage from "@/layouts/LayoutPage.astro";
import { applyCache, dataCache, degradedCache } from "@/lib/cache";
import { loadCached } from "@/lib/data-cache";
import { actorDid, bskyPublicApi, pdsEndpoint } from "@/lib/const";
import {
  collectFootnotes,
  getBlobCid,
  getDocumentBlocks,
  getReadingMinutes,
  toSegments,
} from "@/lib/leaflet";
import { collectProfiles, isSafeUrl, segmentsToHtml } from "@/lib/leaflet-html";
import "@/styles/post.css";

export const prerender = false;

const RKEY_RE = /^[a-z0-9]{13}$/;
const TIMEOUT_MS = 10_000;

const { rkey } = Astro.params;
const saved =
  rkey && RKEY_RE.test(rkey)
    ? await loadCached(
        `post/${rkey}`,
        async () => {
          const document = await getRecord("site.standard.document", rkey);
          if (!document) return null;
          const site = await getPublication(String(document.site ?? ""));
          return { publication: site ?? null, record: document };
        },
        Astro.locals
      )
    : null;
const record = saved?.record;
if (!record) {
  Astro.response.status = 404;
  applyCache(Astro.response, degradedCache);
}

const allBlocks = record ? getDocumentBlocks(record.content) : [];
const footnotes = collectFootnotes(allBlocks);
const minutes = getReadingMinutes(allBlocks);
const coverCid = record ? getBlobCid(record.coverImage) : undefined;
// Most posts use their first image as the cover too, so it isn't shown twice.
const coverIndex = coverCid
  ? allBlocks.findIndex(
      (block) =>
        block.$type === "pub.leaflet.blocks.image" &&
        getBlobCid(block.image) === coverCid
    )
  : -1;
const blocks = allBlocks.filter((_, index) => index !== coverIndex);
const coverAlt =
  coverIndex === -1 ? "" : String(allBlocks[coverIndex]?.alt ?? "");
const coverRatio =
  coverIndex === -1
    ? undefined
    : (allBlocks[coverIndex]?.aspectRatio as
        { height?: number; width?: number } | undefined);

const publication = saved?.publication;
const originalUrl =
  publication?.url && typeof record?.path === "string"
    ? `${publication.url.replace(/\/$/, "")}${record.path}`
    : undefined;

const [embeds, avatars] = await Promise.all([
  getEmbeds(blocks),
  getAvatars(collectProfiles(getAllSegments(allBlocks))),
]);
if (record) applyCache(Astro.response, dataCache);

const title = record
  ? String(record.title ?? "Untitled post")
  : "Post not found";
const description =
  typeof record?.description === "string" ? record.description : undefined;
const tags = Array.isArray(record?.tags) ? (record.tags as string[]) : [];
const publishedAt =
  typeof record?.publishedAt === "string" ? record.publishedAt : undefined;
const date = publishedAt
  ? new Date(publishedAt).toLocaleDateString("en-US", {
      day: "numeric",
      month: "long",
      timeZone: "UTC",
      year: "numeric",
    })
  : undefined;

async function getRecord(
  collection: string,
  key: string,
  repo = actorDid
): Promise<Record<string, unknown> | undefined> {
  const url = new URL("/xrpc/com.atproto.repo.getRecord", pdsEndpoint);
  url.searchParams.set("repo", repo);
  url.searchParams.set("collection", collection);
  url.searchParams.set("rkey", key);

  const response = await fetch(url, {
    signal: AbortSignal.timeout(TIMEOUT_MS),
  }).catch(() => undefined);
  if (!response?.ok) return undefined;

  return ((await response.json()) as { value?: Record<string, unknown> }).value;
}

async function getPublication(uri: string) {
  const match = /^at:\/\/([^/]+)\/([^/]+)\/([^/]+)$/.exec(uri);
  if (!match) return undefined;

  const value = await getRecord(match[2]!, match[3]!, match[1]);
  return value
    ? {
        name: typeof value.name === "string" ? value.name : undefined,
        url: isSafeUrl(value.url) ? value.url : undefined,
      }
    : undefined;
}

// Every piece of rich text in the post, including list items and footnotes.
function getAllSegments(
  value: unknown,
  found: ReturnType<typeof toSegments> = []
) {
  if (Array.isArray(value)) {
    for (const item of value) getAllSegments(item, found);
  } else if (value && typeof value === "object") {
    const node = value as { facets?: unknown; plaintext?: unknown };
    if (typeof node.plaintext === "string") {
      found.push(...toSegments(node.plaintext, (node.facets as never[]) ?? []));
    }
    for (const child of Object.values(value)) getAllSegments(child, found);
  }
  return found;
}

/** The avatars of the Bluesky accounts a post mentions, by DID and handle. */
async function getAvatars(actors: string[]) {
  const found = new Map<string, string>();
  if (actors.length === 0) return found;

  const url = new URL("/xrpc/app.bsky.actor.getProfiles", bskyPublicApi);
  for (const actor of actors.slice(0, 25))
    url.searchParams.append("actors", actor);
  const response = await fetch(url, {
    signal: AbortSignal.timeout(TIMEOUT_MS),
  }).catch(() => undefined);
  if (!response?.ok) return found;

  const { profiles } = (await response.json()) as {
    profiles: { avatar?: string; did: string; handle: string }[];
  };
  for (const profile of profiles) {
    if (!profile.avatar) continue;
    found.set(profile.did, profile.avatar);
    found.set(profile.handle, profile.avatar);
  }
  return found;
}

async function getEmbeds(documentBlocks: unknown[]) {
  const uris = documentBlocks
    .map((block) => (block as { postRef?: { uri?: string } }).postRef?.uri)
    .filter((uri): uri is string => Boolean(uri));
  const found = new Map<string, EmbeddedPost>();
  if (uris.length === 0) return found;

  const url = new URL("/xrpc/app.bsky.feed.getPosts", bskyPublicApi);
  for (const uri of uris.slice(0, 25)) url.searchParams.append("uris", uri);

  const response = await fetch(url, {
    signal: AbortSignal.timeout(TIMEOUT_MS),
  }).catch(() => undefined);
  if (!response?.ok) return found;

  const { posts } = (await response.json()) as {
    posts: {
      author: { avatar?: string; displayName?: string; handle: string };
      likeCount?: number;
      record: { createdAt: string; text: string };
      uri: string;
    }[];
  };
  for (const post of posts) {
    found.set(post.uri, {
      author: post.author,
      createdAt: post.record.createdAt,
      likeCount: post.likeCount ?? 0,
      text: post.record.text,
      url: `https://bsky.app/profile/${post.author.handle}/post/${post.uri.split("/").at(-1)}`,
    });
  }
  return found;
}
---

<LayoutPage title={`${title} | Felix Schneider`} description={description}>
  <div class="post-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-header">
      <a class="post-back button" href="/blog">
        <span aria-hidden="true">←</span> All posts
      </a>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-lede">{description}</p>}
      {!record && (
        <p class="post-lede">
          This post doesn't exist, or it moved. All my posts are on the blog
          page.
        </p>
      )}
      <div class="post-meta" hidden={!record}>
        <p class="post-facts">
          {date && <time datetime={publishedAt}>{date}</time>}
          <span>{minutes} min read</span>
        </p>
        {tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li class="post-tag">{tag}</li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {record?.coverImage && (
      <PostImage
        alt={coverAlt}
        blob={record.coverImage}
        height={coverRatio?.height}
        isCover
        width={coverRatio?.width}
      />
    )}

    <div class="post-body">
      <Blocks
        avatars={avatars}
        blocks={blocks}
        embeds={embeds}
        footnotes={footnotes}
      />
    </div>

    {footnotes.length > 0 && (
      <section class="post-footnotes" aria-labelledby="footnotes-title">
        <h2 id="footnotes-title">Footnotes</h2>
        <ol>
          {footnotes.map((footnote) => (
            <li id={`fn-${footnote.number}`}>
              <span
                set:html={segmentsToHtml(footnote.segments, [], {
                  autolink: true,
                  avatars,
                })}
              />{" "}
              <a
                href={`#fnref-${footnote.number}`}
                aria-label="Back to the text"
              >
                ↩&#xFE0E;
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="post-footer">
      <a class="post-back button" href="/blog">
        <span aria-hidden="true">←</span> All posts
      </a>
      {originalUrl && (
        <a class="post-original button" href={originalUrl}>
          Read on Leaflet
          <ExternalIcon />
        </a>
      )}
    </footer>
  </article>

  <dialog class="post-lightbox" aria-label="Zoomed image">
    <figure class="post-lightbox-figure">
      <img class="post-lightbox-image" alt="" />
      <figcaption class="post-lightbox-caption"></figcaption>
    </figure>
    <button
      class="post-lightbox-close button is-icon"
      type="button"
      aria-label="Close"
    >
      <span aria-hidden="true">×</span>
    </button>
  </dialog>
</LayoutPage>

<script>
  import { setUpPost } from "@/scripts/post";

  setUpPost();
  document.addEventListener("astro:page-load", setUpPost);
</script>
