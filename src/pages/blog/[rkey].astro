---
import Blocks from "@/components/blog/post/Blocks.astro";
import type { EmbeddedPost } from "@/components/blog/post/BskyEmbed.astro";
import LayoutPage from "@/layouts/LayoutPage.astro";
import { applyCache, degradedCache, longLivedCache } from "@/lib/cache";
import { actorDid, bskyPublicApi, pdsEndpoint } from "@/lib/const";
import {
  collectFootnotes,
  getBlobCid,
  getDocumentBlocks,
  getReadingMinutes,
} from "@/lib/leaflet";
import { isSafeUrl, segmentsToHtml } from "@/lib/leaflet-html";
import "@/styles/post.css";

export const prerender = false;

const RKEY_RE = /^[a-z0-9]{13}$/;
const TIMEOUT_MS = 10_000;

const { rkey } = Astro.params;
const record =
  rkey && RKEY_RE.test(rkey)
    ? await getRecord("site.standard.document", rkey)
    : undefined;
if (!record) {
  Astro.response.status = 404;
  applyCache(Astro.response, degradedCache);
}

const blocks = record ? getDocumentBlocks(record.content) : [];
const footnotes = collectFootnotes(blocks);
const minutes = getReadingMinutes(blocks);
const blobUrl = (cid: string) =>
  `${pdsEndpoint}/xrpc/com.atproto.sync.getBlob?did=${actorDid}&cid=${cid}`;
const coverCid = record ? getBlobCid(record.coverImage) : undefined;

const publication = record
  ? await getPublication(String(record.site ?? ""))
  : undefined;
const originalUrl =
  publication?.url && typeof record?.path === "string"
    ? `${publication.url.replace(/\/$/, "")}${record.path}`
    : undefined;

const embeds = await getEmbeds(blocks);
if (record) applyCache(Astro.response, longLivedCache);

const title = record
  ? String(record.title ?? "Untitled post")
  : "Post not found";
const description =
  typeof record?.description === "string" ? record.description : undefined;
const tags = Array.isArray(record?.tags) ? (record.tags as string[]) : [];
const publishedAt =
  typeof record?.publishedAt === "string" ? record.publishedAt : undefined;
const date = publishedAt
  ? new Date(publishedAt).toLocaleDateString("en-US", {
      day: "numeric",
      month: "long",
      timeZone: "UTC",
      year: "numeric",
    })
  : undefined;

async function getRecord(
  collection: string,
  key: string,
  repo = actorDid
): Promise<Record<string, unknown> | undefined> {
  const url = new URL("/xrpc/com.atproto.repo.getRecord", pdsEndpoint);
  url.searchParams.set("repo", repo);
  url.searchParams.set("collection", collection);
  url.searchParams.set("rkey", key);

  const response = await fetch(url, {
    signal: AbortSignal.timeout(TIMEOUT_MS),
  }).catch(() => undefined);
  if (!response?.ok) return undefined;

  return ((await response.json()) as { value?: Record<string, unknown> }).value;
}

async function getPublication(uri: string) {
  const match = /^at:\/\/([^/]+)\/([^/]+)\/([^/]+)$/.exec(uri);
  if (!match) return undefined;

  const value = await getRecord(match[2]!, match[3]!, match[1]);
  return value
    ? {
        name: typeof value.name === "string" ? value.name : undefined,
        url: isSafeUrl(value.url) ? value.url : undefined,
      }
    : undefined;
}

async function getEmbeds(documentBlocks: unknown[]) {
  const uris = documentBlocks
    .map((block) => (block as { postRef?: { uri?: string } }).postRef?.uri)
    .filter((uri): uri is string => Boolean(uri));
  const found = new Map<string, EmbeddedPost>();
  if (uris.length === 0) return found;

  const url = new URL("/xrpc/app.bsky.feed.getPosts", bskyPublicApi);
  for (const uri of uris.slice(0, 25)) url.searchParams.append("uris", uri);

  const response = await fetch(url, {
    signal: AbortSignal.timeout(TIMEOUT_MS),
  }).catch(() => undefined);
  if (!response?.ok) return found;

  const { posts } = (await response.json()) as {
    posts: {
      author: { avatar?: string; displayName?: string; handle: string };
      likeCount?: number;
      record: { createdAt: string; text: string };
      uri: string;
    }[];
  };
  for (const post of posts) {
    found.set(post.uri, {
      author: post.author,
      createdAt: post.record.createdAt,
      likeCount: post.likeCount ?? 0,
      text: post.record.text,
      url: `https://bsky.app/profile/${post.author.handle}/post/${post.uri.split("/").at(-1)}`,
    });
  }
  return found;
}
---

<LayoutPage title={`${title} | Felix Schneider`} description={description}>
  <div class="post-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-header">
      <a class="post-back" href="/blog">
        ← All posts
      </a>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-lede">{description}</p>}
      {!record && (
        <p class="post-lede">
          This post doesn't exist, or it moved. All my posts are on the blog
          page.
        </p>
      )}
      <p class="post-meta" hidden={!record}>
        {date && <time datetime={publishedAt}>{date}</time>}
        <span>{minutes} min read</span>
        {tags.map((tag) => (
          <span class="post-tag">{tag}</span>
        ))}
      </p>
    </header>

    {coverCid && (
      <figure class="post-image post-cover" style="--tilt: -0.6deg">
        <img src={blobUrl(coverCid)} alt="" fetchpriority="high" />
      </figure>
    )}

    <div class="post-body">
      <Blocks
        blobUrl={blobUrl}
        blocks={blocks}
        embeds={embeds}
        footnotes={footnotes}
      />
    </div>

    {footnotes.length > 0 && (
      <section class="post-footnotes" aria-labelledby="footnotes-title">
        <h2 id="footnotes-title">Footnotes</h2>
        <ol>
          {footnotes.map((footnote) => (
            <li id={`fn-${footnote.number}`}>
              <span
                set:html={segmentsToHtml(footnote.segments, [], {
                  autolink: true,
                })}
              />{" "}
              <a
                href={`#fnref-${footnote.number}`}
                aria-label="Back to the text"
              >
                ↩&#xFE0E;
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="post-footer">
      <a class="post-back" href="/blog">
        ← All posts
      </a>
      {originalUrl && (
        <a class="post-original" href={originalUrl}>
          Also on {publication?.name ?? "Leaflet"} ↗&#xFE0E;
        </a>
      )}
    </footer>
  </article>
</LayoutPage>

<script>
  function setUpCopyButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      ".post-copy[data-copy]"
    )) {
      if (button.dataset.ready) continue;
      button.dataset.ready = "true";
      button.addEventListener("click", async () => {
        const code = button
          .closest(".post-code")
          ?.querySelector("pre")?.textContent;
        if (!code) return;
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1600);
      });
    }
  }

  setUpCopyButtons();
  document.addEventListener("astro:page-load", setUpCopyButtons);
</script>
