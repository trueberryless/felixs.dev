---
import MusicContent from "@/components/music/MusicContent.astro";
import MusicSkeleton from "@/components/music/MusicSkeleton.astro";
import NowPlaying from "@/components/landing/NowPlaying.astro";
import PageHeader from "@/components/utils/PageHeader.astro";
import LayoutPage from "@/layouts/LayoutPage.astro";
import { tealProfileUrl } from "@/lib/const";
import "@/styles/music.css";

export const prerender = true;
---

<LayoutPage title="Music | Felix Schneider">
  <PageHeader title="Music">
    <Fragment slot="description">
      What I listen to, straight from my AT Protocol repository. Every play is
      saved to <a href={tealProfileUrl}>teal.fm</a> as I listen, back to my very
      first stream in 2018.
    </Fragment>
  </PageHeader>

  <NowPlaying
    title="Now playing"
    actionHref={tealProfileUrl}
    actionText="teal.fm"
  />

  <MusicContent server:defer>
    <MusicSkeleton slot="fallback" />
  </MusicContent>
</LayoutPage>

<script>
  import "@/scripts/music/music-stats";
</script>
