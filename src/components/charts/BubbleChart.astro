---
import { fillBubbles, packBubbles } from "@/lib/bubbles";
import type { Bubble } from "@/lib/stories";

interface Props {
  bubbles: Bubble[];
  /** Fills the whole box instead of packing the bubbles into a circle. */
  fill?: boolean;
  height?: number;
  label: string;
  /**
   * Sizes bubbles by the square root of their value, so a few huge values
   * don't shrink everything else to dots. Tooltips keep the exact numbers.
   */
  scale?: "linear" | "sqrt";
  /** Hides the numbers when the values only size the bubbles. */
  showValues?: boolean;
  width?: number;
}

const {
  bubbles,
  fill = false,
  height = 300,
  label,
  scale = "linear",
  showValues = true,
  width = 420,
} = Astro.props;

const compact = new Intl.NumberFormat("en-US", {
  maximumFractionDigits: 1,
  notation: "compact",
});
const packed = fill
  ? fillBubbles(bubbles, { height, width })
  : packBubbles(bubbles, { height, scale, width });
const circles = packed.map((circle) =>
  Object.assign(circle, {
    showValue: showValues && Boolean(circle.lines) && circle.r > 34,
  })
);
// Charts with links are a group of links, not a single image.
const hasLinks = bubbles.some((bubble) => bubble.href || bubble.key);
---

<div class="bubble-wrap" data-bubbles>
  <svg
    class="bubble-chart"
    viewBox={`0 0 ${width} ${height}`}
    data-scale={scale}
    role={hasLinks ? "group" : "img"}
    aria-label={label}
  >
    {circles.map((circle) => {
      const lines = circle.lines ?? [];
      const size = circle.size;
      const lineHeight = size * 1.15;
      const blockHeight =
        lines.length * lineHeight + (circle.showValue ? 13 : 0);
      const firstY = circle.y - blockHeight / 2 + lineHeight / 2;
      const content = (
        <>
          <circle
            class="bubble"
            cx={circle.x}
            cy={circle.y}
            r={circle.r}
            style={`--strength: ${Math.max(18, 72 - circle.index * 7)}%; --i: ${circle.index}`}
          />
          <g class="bubble-text">
            {/* Spaces between the lines and the value keep them apart as
                words, so the name read out matches the text on screen. */}
            {lines.map((line, index) => (
              <>
                {index > 0 && " "}
                <text
                  class="bubble-label"
                  x={circle.x}
                  y={firstY + index * lineHeight}
                  style={`font-size: ${size.toFixed(1)}px`}
                >
                  {line}
                </text>
              </>
            ))}
            {circle.showValue && " "}
            {circle.showValue && (
              <text
                class="bubble-value"
                x={circle.x}
                y={firstY + lines.length * lineHeight + 2}
              >
                {compact.format(circle.value)}
              </text>
            )}
          </g>
        </>
      );

      return circle.href ? (
        <a
          class="bubble-group"
          href={circle.href}
          aria-label={circle.title}
          data-tip={circle.title}
          style={`--i: ${circle.index}`}
        >
          {content}
        </a>
      ) : circle.key ? (
        <g
          class="bubble-group is-toggle"
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label={circle.title}
          data-key={circle.key}
          data-tip={circle.title}
          style={`--i: ${circle.index}`}
        >
          {content}
        </g>
      ) : (
        <g
          class="bubble-group"
          data-tip={circle.title}
          style={`--i: ${circle.index}`}
        >
          {content}
        </g>
      );
    })}
  </svg>
  <span class="bubble-tip" aria-hidden="true"></span>
</div>

<script>
  // One tooltip per chart instead of the browser's plain title tooltip. With
  // a mouse it glides after the pointer and leans into the movement, like
  // the covers on the blog list. Keyboard focus puts it above the bubble.
  const TIP_FOLLOW = 0.2;
  const TIP_LIFT = 18;

  function enableTips() {
    const smooth = window.matchMedia(
      "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
    );
    for (const wrap of document.querySelectorAll<HTMLElement>(
      "[data-bubbles]:not([data-tips])"
    )) {
      wrap.dataset.tips = "";
      const tip = wrap.querySelector<HTMLElement>(".bubble-tip");
      if (!tip) continue;

      let target = { x: 0, y: 0 };
      let position = { x: 0, y: 0 };
      let tilt = 0;
      let frame = 0;

      const place = () => {
        tip.style.left = `${position.x.toFixed(1)}px`;
        tip.style.top = `${position.y.toFixed(1)}px`;
        tip.style.rotate = `${tilt.toFixed(2)}deg`;
      };
      const step = () => {
        const dx = target.x - position.x;
        position = {
          x: position.x + dx * TIP_FOLLOW,
          y: position.y + (target.y - position.y) * TIP_FOLLOW,
        };
        tilt += (Math.max(-6, Math.min(6, dx * 0.06)) - tilt) * TIP_FOLLOW;
        place();
        const settled =
          Math.abs(dx) < 0.3 &&
          Math.abs(target.y - position.y) < 0.3 &&
          Math.abs(tilt) < 0.05;
        frame = settled ? 0 : requestAnimationFrame(step);
      };

      const label = (event: Event) =>
        (event.target as Element).closest<SVGGElement>(".bubble-group")?.dataset
          .tip;

      wrap.addEventListener("pointermove", (event) => {
        const text = label(event);
        if (!text) {
          tip.classList.remove("is-visible");
          return;
        }
        const box = wrap.getBoundingClientRect();
        target = {
          x: event.clientX - box.left,
          y: event.clientY - box.top - TIP_LIFT,
        };
        tip.textContent = text;
        if (!tip.classList.contains("is-visible") || !smooth.matches) {
          position = { ...target };
          tilt = 0;
          place();
        }
        tip.classList.add("is-visible");
        if (smooth.matches) frame ||= requestAnimationFrame(step);
      });
      wrap.addEventListener("focusin", (event) => {
        const circle = (event.target as Element)
          .closest(".bubble-group")
          ?.querySelector("circle");
        const text = label(event);
        if (!circle || !text) return;
        const box = circle.getBoundingClientRect();
        const frameBox = wrap.getBoundingClientRect();
        position = {
          x: box.left + box.width / 2 - frameBox.left,
          y: box.top - frameBox.top,
        };
        target = { ...position };
        tilt = 0;
        place();
        tip.textContent = text;
        tip.classList.add("is-visible");
      });
      const hide = () => tip.classList.remove("is-visible");
      wrap.addEventListener("pointerleave", hide);
      wrap.addEventListener("focusout", hide);
    }
  }
  enableTips();
  document.addEventListener("astro:page-load", enableTips);
  // Islands arrive after the page, and the client router swaps the whole
  // body on every navigation, so the watch is on the root.
  new MutationObserver(enableTips).observe(document.documentElement, {
    childList: true,
    subtree: true,
  });
</script>

<style>
  .bubble-wrap {
    position: relative;
  }

  .bubble-chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bubble-group {
    cursor: default;
    outline: none;
    transition: opacity 0.35s ease;
  }

  a.bubble-group,
  .bubble-group.is-toggle {
    cursor: pointer;
  }

  .bubble-chart:has([aria-pressed="true"])
    .bubble-group:not([aria-pressed="true"]) {
    opacity: 0.4;
  }

  .bubble-group[aria-pressed="true"] .bubble {
    fill: color-mix(in oklch, var(--accent) 88%, transparent);
    stroke: var(--text);
    stroke-width: 2;
  }

  .bubble-group.is-toggle:focus-visible .bubble {
    stroke: var(--text);
    stroke-width: 2.5;
  }

  .bubble {
    fill: color-mix(in oklch, var(--accent) var(--strength), transparent);
    stroke: color-mix(in oklch, var(--accent) 60%, transparent);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      scale 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      fill 0.35s ease,
      stroke 0.35s ease,
      stroke-width 0.35s ease,
      cx 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      cy 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      r 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bubble-text {
    transition: opacity 0.25s ease;
  }

  .bubble-chart.is-moving .bubble-text {
    opacity: 0;
  }

  .bubble-chart:has(.bubble-group:is(:hover, :focus-visible))
    .bubble-group:not(:hover, :focus-visible) {
    opacity: 0.4;
  }

  @media (hover: hover) {
    .bubble-group:is(:hover, :focus-visible) .bubble {
      scale: 1.02;
      fill: color-mix(in oklch, var(--accent) 88%, transparent);
      stroke: var(--text);
      stroke-width: 2;
    }
  }

  /* Repacked bubbles get their labels from a script, so these styles reach
     past this component's scope. */
  .bubble-chart :global(:is(.bubble-label, .bubble-value)) {
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }

  .bubble-chart :global(.bubble-label) {
    font-weight: 600;
    fill: var(--text);
  }

  .bubble-chart :global(.bubble-value) {
    font-size: 10px;
    fill: var(--text);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .bubble-tip {
    position: absolute;
    z-index: 3;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--header-bg-solid);
    box-shadow: var(--lift-shadow);
    color: var(--text);
    font-size: 0.85rem;
    white-space: nowrap;
    pointer-events: none;
    translate: -50% calc(-100% - 4px);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      translate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bubble-tip.is-visible {
    opacity: 1;
    translate: -50% calc(-100% - 10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bubble-group {
      transition:
        opacity 0.35s ease,
        translate 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .bubble {
      transition:
        scale 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        fill 0.35s ease,
        stroke 0.35s ease,
        stroke-width 0.35s ease,
        cx 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        cy 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        r 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(0.3s + var(--i) * 45ms), 0s, 0s, 0s, 0s, 0s, 0s;
    }

    :global(.story-frame:not([data-active="true"])) .bubble {
      scale: 0.2;
      transition-delay: 0s;
    }

    :global(.story-frame:not([data-active="true"]))
      :is(.bubble-label, .bubble-value) {
      opacity: 0;
    }

    .bubble-label,
    .bubble-value {
      transition: opacity 0.4s ease calc(0.6s + var(--i) * 45ms);
    }
  }
</style>
