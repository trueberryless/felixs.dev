---
import Story from "@/components/story/Story.astro";

type Part = string | { bone: string };

interface Props {
  href: string;
  kicker: string;
  linkText: string;
  /** The text under the title, one paragraph per entry. */
  text: Part[][];
  /** The title, with bones for the parts that come from data. */
  title: Part[];
  /** Width over height of the story's chart. */
  visual: number;
}

// A story as it will look, with the same copy and bones where its data goes.
const { href, kicker, linkText, text, title, visual } = Astro.props;
---

<Story kicker={kicker} href={href} linkText={linkText}>
  <Fragment slot="title">
    {title.map((part) =>
      typeof part === "string" ? part : <em class="bone">{part.bone}</em>
    )}
  </Fragment>
  <Fragment slot="text">
    {text.map((paragraph) => (
      <p>
        {paragraph.map((part) =>
          typeof part === "string" ? (
            part
          ) : (
            <span class="bone is-text">{part.bone}</span>
          )
        )}
      </p>
    ))}
  </Fragment>
  <div
    slot="visual"
    class="skeleton story-skeleton-visual bone"
    style={`aspect-ratio: ${visual}`}
    aria-hidden="true"
  />
</Story>

<style>
  .story-skeleton-visual {
    display: block;
    width: 100%;
    border-radius: var(--radius-card);
  }
</style>
