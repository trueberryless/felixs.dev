---
interface Props {
  href?: string;
  kicker: string;
  linkText?: string;
}

const { href, kicker, linkText } = Astro.props;
const isExternal = href ? /^https?:\/\//.test(href) : false;
---

<div class="story-frame">
  <section class="story">
    <div class="story-copy">
      <span class="story-kicker">{kicker}</span>
      <h2 class="story-title">
        <span class="story-title-text">
          <slot name="title" />
        </span>
      </h2>
      <div class="story-text">
        <slot name="text" />
      </div>
      {href && linkText && (
        <a class="story-link" href={href}>
          <span>{linkText}</span>
          <span class="story-arrow" aria-hidden="true">
            {isExternal ? "↗︎" : "→"}
          </span>
        </a>
      )}
    </div>
    <div class="story-visual">
      <slot name="visual" />
    </div>
  </section>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(48px, 10vh, 112px);
  }

  @media (min-width: 860px) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      min-height: min(78svh, 760px);
    }

    /* Copy and visual swap sides from one section to the next. Counting the
       rendered frames keeps the rhythm right when a section has nothing to
       show and renders nothing. */
    :global(.story-frame:nth-child(even of .story-frame)) .story {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    :global(.story-frame:nth-child(even of .story-frame)) .story-copy {
      order: 2;
    }
  }

  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .story-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .story-kicker::before {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .story-title {
    font-size: clamp(1.9rem, 4.4vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  /* The theme's gradient runs through every line of the heading. */
  .story-title-text {
    background-image: var(--text-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .story-title :global(em) {
    font-style: normal;
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  .story-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 8px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--badge-bg);
    color: var(--text);
    font-size: 0.9rem;
    transition:
      translate 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .story-link:hover {
    translate: 0 -2px;
    box-shadow: var(--lift-shadow);
    border-color: var(--text-muted);
  }

  .story-arrow {
    transition: translate 0.25s ease;
  }

  .story-link:hover .story-arrow {
    translate: 3px 0;
  }

  .story-visual {
    min-width: 0;
  }

  /* On wide screens every section pins itself to the middle of the screen,
     holds for a while and then hands over to the next one: it rises in and
     sharpens, stays put while you scroll, and drifts up and fades as the next
     section arrives. So a section never sits half cut off at the edge. The
     first section doesn't fade in and the last one doesn't fade out. */
  @media (min-width: 860px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .story-frame {
        height: 170svh;
        view-timeline: --story block;
      }

      .story {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 0;
        padding-block: 96px 48px;
      }

      .story-copy,
      .story-visual {
        animation:
          story-in linear both,
          story-out linear both;
        animation-timeline: --story, --story;
        animation-range:
          entry 35% entry 100%,
          exit 0% exit 45%;
      }

      .story-visual {
        --story-shift: 90px;
      }

      :global(.story-frame:nth-child(1 of .story-frame)) .story-copy,
      :global(.story-frame:nth-child(1 of .story-frame)) .story-visual {
        animation-name: none, story-out;
      }

      :global(.story-frame:nth-last-child(1 of .story-frame)) .story-copy,
      :global(.story-frame:nth-last-child(1 of .story-frame)) .story-visual {
        animation-name: story-in, none;
      }
    }
  }

  /* Narrow screens scroll normally, the sections only drift into place. */
  @media (max-width: 859px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .story-copy,
      .story-visual {
        animation: story-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }

  @keyframes story-in {
    from {
      opacity: 0;
      translate: 0 var(--story-shift, 56px);
      scale: 0.97;
      filter: blur(10px);
    }
  }

  @keyframes story-out {
    to {
      opacity: 0;
      translate: 0 calc(var(--story-shift, 56px) * -0.7);
      scale: 0.98;
      filter: blur(8px);
    }
  }

  @keyframes story-rise {
    from {
      translate: 0 32px;
      filter: blur(6px);
    }
  }
</style>
