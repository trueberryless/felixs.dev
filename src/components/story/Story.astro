---
interface Props {
  href?: string;
  kicker: string;
  linkText?: string;
}

const { href, kicker, linkText } = Astro.props;
const isExternal = href ? /^https?:\/\//.test(href) : false;
---

<div class="story-frame">
  <section class="story">
    <div class="story-copy">
      <span class="story-kicker">{kicker}</span>
      <h2 class="story-title">
        <span class="story-title-text">
          <slot name="title" />
        </span>
      </h2>
      <div class="story-text">
        <slot name="text" />
      </div>
      {href && linkText && (
        <a class="story-link" href={href}>
          <span>{linkText}</span>
          <span class="story-arrow" aria-hidden="true">
            {isExternal ? "↗︎" : "→"}
          </span>
        </a>
      )}
    </div>
    <div class="story-visual">
      <slot name="visual" />
    </div>
  </section>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(48px, 10vh, 112px);
  }

  @media (min-width: 860px) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      min-height: min(78svh, 760px);
    }

    /* Copy and visual swap sides from one section to the next. Counting the
       rendered frames keeps the rhythm right when a section has nothing to
       show and renders nothing. */
    :global(.story-frame:nth-child(even of .story-frame)) .story {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    :global(.story-frame:nth-child(even of .story-frame)) .story-copy {
      order: 2;
    }
  }

  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .story-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .story-kicker::before {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .story-title {
    font-size: clamp(1.9rem, 4.4vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  /* The theme's gradient runs through every line of the heading. */
  .story-title-text {
    background-image: var(--text-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .story-title :global(em) {
    font-style: normal;
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 44ch;
  }

  .story-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 8px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--badge-bg);
    color: var(--text);
    font-size: 0.9rem;
    transition:
      translate 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .story-link:hover {
    translate: 0 -2px;
    box-shadow: var(--lift-shadow);
    border-color: var(--text-muted);
  }

  .story-arrow {
    transition: translate 0.25s ease;
  }

  .story-link:hover .story-arrow {
    translate: 3px 0;
  }

  .story-visual {
    min-width: 0;
  }

  /* Every part of a section arrives on its own, a few frames apart, and
     leaves in the direction you scroll: it fades, blurs and drifts a little.
     The landing page script marks the sections that aren't on stage with
     `data-active="false"`. */
  .story-copy > :global(:nth-child(2)) {
    --k: 1;
  }

  .story-copy > :global(:nth-child(3)),
  .story-visual {
    --k: 2;
  }

  .story-copy > :global(:nth-child(4)) {
    --k: 3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-copy > :global(*),
    .story-visual {
      transition:
        opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
        translate 0.8s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.6s ease;
      transition-delay: calc(0.18s + var(--k, 0) * 70ms);
    }

    :global(.story-frame[data-active="false"]) .story-copy > :global(*),
    :global(.story-frame[data-active="false"]) .story-visual {
      opacity: 0;
      translate: 0 1.5rem;
      filter: blur(6px);
      transition:
        opacity 0.45s cubic-bezier(0.4, 0, 1, 1),
        translate 0.5s cubic-bezier(0.4, 0, 1, 1),
        filter 0.45s ease;
      transition-delay: calc(var(--k, 0) * 30ms);
    }

    :global(.story-frame[data-active="false"][data-side="before"])
      .story-copy
      > :global(*),
    :global(.story-frame[data-active="false"][data-side="before"])
      .story-visual {
      translate: 0 -1.5rem;
    }
  }
</style>
