---
import NumberCards from "@/components/utils/NumberCards.astro";
import FilterChip from "@/components/utils/FilterChip.astro";
import EventCard from "@/components/events/EventCard.astro";
import Fallback from "@/components/utils/Fallback.astro";
import Section from "@/components/utils/Section.astro";
import { fetchEvents } from "@/lib/data";
import { getPeopleMet, getPlaces } from "@/lib/events";
import { applyCache, dailyCache, degradedCache } from "@/lib/cache";

const events = await fetchEvents().catch(() => null);
applyCache(Astro.response, events ? dailyCache : degradedCache);
const hasData = Boolean(events && events.length > 0);

const now = Date.now();
const processed = [];
for (const e of hasData ? events! : []) {
  processed.push({
    ...e,
    startDate: new Date(e.startDate),
    endDate: new Date(e.endDate),
    isPast: new Date(e.endDate).getTime() < now,
  });
}

const upcoming = processed
  .filter((e) => !e.isPast)
  .sort((a, b) => a.startDate.getTime() - b.startDate.getTime());
const past = processed.filter((e) => e.isPast);

const people = getPeopleMet(events ?? [], now);
const places = getPlaces(events ?? []);
const numbers = [
  { label: past.length === 1 ? "event" : "events", value: past.length },
  { label: "people met", value: people.length },
  { label: places.length === 1 ? "place" : "places", value: places.length },
  { label: "coming up", value: upcoming.length },
];
const mostMet = people[0]?.count ?? 1;
// Every face pops in one after another within about a second and a half,
// however many there are, and the rest of the page follows the last one.
const PEOPLE_MS = 1500;
const peopleStep = Math.min(25, PEOPLE_MS / Math.max(people.length, 1));
const afterPeople =
  people.length > 0 ? 200 + people.length * peopleStep + 250 : 0;
---

{hasData ? (
  <div
    class="events"
    style={`--people-step: ${peopleStep.toFixed(1)}ms; --after-people: ${afterPeople.toFixed(0)}ms`}
  >
    <NumberCards numbers={numbers} />

    {people.length > 0 && (
      <Section title="People I met">
        <p class="events-lede">
          Everyone who went to the same events as me. The more often we met, the
          bigger they are.
        </p>
        <ul class="people">
          {people.map((person, index) => (
            <li
              style={`--size: ${32 + Math.round((person.count / mostMet) * 32)}px; --i: ${index}`}
            >
              <a
                class="person"
                href={`https://bsky.app/profile/${person.handle}`}
                aria-label={`${person.name || person.handle}, met at ${person.count} ${person.count === 1 ? "event" : "events"}`}
                title={`${person.name || person.handle} · ${person.count} ${person.count === 1 ? "event" : "events"}`}
              >
                {person.avatar ? (
                  <img
                    src={person.avatar}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="person-initial" aria-hidden="true">
                    {(person.name || person.handle).slice(0, 1).toUpperCase()}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <div class="events-later">
      <Section title="Every event">
        <events-timeline>
          {places.length > 1 && (
            <div class="places" role="group" aria-label="Show events at">
              {places.map((place) => (
                <FilterChip
                  class="place"
                  count={place.count}
                  data-place={place.name}
                >
                  {place.name}
                </FilterChip>
              ))}
            </div>
          )}
          <p class="sr-only" aria-live="polite" data-status />
          <div class="timeline-container">
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}

            {upcoming.length > 0 && past.length > 0 && (
              <div class="today-divider" data-today>
                <span class="today-text">Today</span>
              </div>
            )}

            {past.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </events-timeline>
      </Section>
    </div>
  </div>
) : (
  <Fallback
    description="My RSVPs live on ATproto and aren't reachable right now. You can view them directly on atmo.rsvp."
    fallbackHref="https://atmo.rsvp/p/did:plc:pbjvqaziagcyv2vqodldn5op"
    fallbackLabel="See my RSVPs on atmo.rsvp"
  />
)}

<style>
  .events-lede {
    margin-bottom: 20px;
    color: var(--text-muted);
  }

  .people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .person {
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    border: 2px solid var(--card-bg);
    border-radius: 50%;
    background: var(--badge-bg);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow 0.25s ease;
  }

  .person img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person:hover,
  .person:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
    outline: none;
  }

  .places {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .timeline-container :global(.timeline-row[hidden]),
  .today-divider[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .timeline-container :global(.timeline-row.is-returning) {
      animation: events-rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .people li {
      animation: events-pop 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(0.2s + var(--i) * var(--people-step));
    }

    .events-later {
      animation: events-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--after-people);
    }
  }

  @keyframes events-rise {
    from {
      opacity: 0;
      translate: 0 12px;
      filter: blur(6px);
    }
  }

  @keyframes events-pop {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  .timeline-container {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .today-divider {
    display: flex;
    align-items: center;
    margin: 20px 0 60px 0;
    width: 100%;
  }

  .today-divider::before,
  .today-divider::after {
    content: "";
    flex: 1;
    border-top: 2px dotted var(--border);
  }

  .today-text {
    padding: 0 24px;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
</style>

<script>
  // A place narrows the timeline down to the events there. The "Today"
  // divider only stays while events on both sides of it are shown.
  class EventsTimeline extends HTMLElement {
    #place: string | undefined;

    connectedCallback() {
      if (this.dataset.ready !== undefined) return;
      this.dataset.ready = "";
      this.addEventListener("click", (event) => {
        const chip = (event.target as Element).closest<HTMLElement>(".place");
        if (!chip) return;
        const name = chip.dataset.place;
        this.#place = this.#place === name ? undefined : name;
        this.#apply();
      });
    }

    #apply() {
      for (const chip of this.querySelectorAll<HTMLElement>(".place")) {
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.place === this.#place)
        );
      }
      const rows = [...this.querySelectorAll<HTMLElement>(".timeline-row")];
      for (const row of rows) {
        const wasHidden = row.hidden;
        row.hidden = Boolean(this.#place) && row.dataset.place !== this.#place;
        if (wasHidden && !row.hidden) {
          row.classList.remove("is-returning");
          void row.offsetWidth;
          row.classList.add("is-returning");
        }
      }
      const today = this.querySelector<HTMLElement>("[data-today]");
      if (today) {
        const isShown = (row: Element | null) =>
          row instanceof HTMLElement && !row.hidden;
        const before = rows.filter(
          (row) =>
            today.compareDocumentPosition(row) &
            Node.DOCUMENT_POSITION_PRECEDING
        );
        const after = rows.filter((row) => !before.includes(row));
        today.hidden = !before.some(isShown) || !after.some(isShown);
      }
      const status = this.querySelector("[data-status]");
      if (status) {
        const shown = rows.filter((row) => !row.hidden).length;
        status.textContent = this.#place
          ? `${shown} ${shown === 1 ? "event" : "events"} at ${this.#place}.`
          : "All events.";
      }
    }
  }

  if (!customElements.get("events-timeline")) {
    customElements.define("events-timeline", EventsTimeline);
  }
</script>
