---
import FilterChip from "@/components/utils/FilterChip.astro";
import EventCard from "@/components/events/EventCard.astro";
import NumberCards from "@/components/utils/NumberCards.astro";
import Section from "@/components/utils/Section.astro";

// The same sections as the page, with bones where the data goes.
const people = [
  64, 52, 44, 40, 40, 36, 36, 36, 34, 34, 32, 32, 32, 32, 32, 32, 32, 32, 32,
  32, 32, 32, 32, 32,
];
const places = [
  "Metalab",
  "Getreidemarkt 1",
  "Gumpendorfer Straße 10-12",
  "OTOTO Store & Specialty Coffee",
  "Rathausstraße 6",
  "Zieglergasse 38",
];
---

<div class="skeleton" aria-hidden="true">
  <NumberCards
    numbers={[
      { label: "events" },
      { label: "people met" },
      { label: "places" },
      { label: "coming up" },
    ]}
  />

  <Section title="People I met">
    <p class="skeleton-lede">
      Everyone who went to the same events as me. The more often we met, the
      bigger they are.
    </p>
    <div class="skeleton-people">
      {people.map((size) => (
        <span class="bone" style={`--size: ${size}px`} />
      ))}
    </div>
  </Section>

  <Section title="Every event">
    <div class="skeleton-places">
      {places.map((name) => (
        <FilterChip skeleton count={1}>
          {name}
        </FilterChip>
      ))}
    </div>
    <div>
      {Array.from({ length: 4 }, () => (
        <EventCard skeleton />
      ))}
    </div>
  </Section>
</div>

<style>
  .skeleton-lede {
    margin-bottom: 20px;
    color: var(--text-muted);
  }

  .skeleton-people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .skeleton-people .bone {
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
  }

  .skeleton-places {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }
</style>
