---
import {
  BriefcaseBusiness,
  GraduationCap,
  Trophy,
  Wrench,
} from "@lucide/astro";

import HonorCard from "@/components/resume/HonorCard.astro";
import ResumeChapter from "@/components/resume/ResumeChapter.astro";
import NumberCards from "@/components/utils/NumberCards.astro";
import Section from "@/components/utils/Section.astro";

// The resume itself, built from the same parts, with bones for the text.
const description =
  "A few sentences about what I did there and what I worked on, long enough to run over three lines like the real ones do on a wide screen, and a bit more.";
---

<div class="skeleton" aria-hidden="true">
  <NumberCards
    numbers={[
      { label: "years shipping software" },
      { label: "positions" },
      { label: "skills" },
      { label: "awards" },
    ]}
  />

  <Section title="At a glance">
    <div class="skeleton-career bone" />
    <div class="skeleton-legend">
      <span>Work</span>
      <span>Education</span>
      <span>Open source</span>
    </div>
  </Section>

  <Section title="Experience">
    <BriefcaseBusiness
      slot="leading"
      class="skeleton-icon"
      width={18}
      height={18}
    />
    <ol class="skeleton-chapters">
      <ResumeChapter
        chips={["TypeScript", "Vue", "Azure", "C#"]}
        description={description}
        end="Jan 2026"
        index={0}
        isCurrent={false}
        kind="work"
        organisation="A company"
        skeleton
        start="Jan 2024"
        title="A position title"
      />
      <ResumeChapter
        description={description}
        end={null}
        index={1}
        isCurrent
        kind="open-source"
        organisation="On GitHub and Tangled"
        skeleton
        start="Oct 2023"
        title="Open source maintainer"
      >
        <span class="button is-small bone">See the projects →</span>
      </ResumeChapter>
    </ol>
  </Section>

  <Section title="Education">
    <GraduationCap
      slot="leading"
      class="skeleton-icon"
      width={18}
      height={18}
    />
    <ol class="skeleton-chapters">
      {[0, 1, 2].map((index) => (
        <ResumeChapter
          end="Jun 2023"
          index={index}
          isCurrent={false}
          kind="education"
          meta={index > 0 ? ["Grade 1.0"] : []}
          organisation="A school"
          skeleton
          start="Sep 2019"
          title="A degree, in a field"
        />
      ))}
    </ol>
  </Section>

  <Section title="Awards & Honors">
    <Trophy slot="leading" class="skeleton-icon" width={18} height={18} />
    <ol class="skeleton-chapters">
      {[0, 1, 2].map((index) => (
        <HonorCard
          honor={{
            awardedAt: "Nov 2024",
            description:
              index === 0
                ? "A sentence about the award. https://example.com"
                : "A sentence or two about the award and why I got it, long enough to wrap onto a second line. https://example.com",
            issuer: "Issuer",
            title: "An award title",
          }}
          index={index}
          skeleton
        />
      ))}
    </ol>
  </Section>

  <Section title="Skills">
    <Wrench slot="leading" class="skeleton-icon" width={18} height={18} />
    <div class="skeleton-skills">
      <p class="skeleton-hint">
        Bigger bubbles show up in more of my positions.
      </p>
      <div class="skeleton-bubbles bone" />
    </div>
  </Section>
</div>

<style>
  .skeleton-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  /* The timeline shows six years across the full width, five rows high. */
  .skeleton-career {
    display: block;
    aspect-ratio: 660 / 334;
    margin-bottom: 6px;
  }

  .skeleton-legend {
    display: flex;
    gap: 16px;
    margin-top: 10px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .skeleton-chapters {
    padding: 0;
    list-style: none;
  }

  .skeleton-skills {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .skeleton-hint {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .skeleton-bubbles {
    display: block;
    aspect-ratio: 760 / 420;
    border-radius: var(--radius-card);
  }

  @media (max-width: 640px) {
    .skeleton-bubbles {
      aspect-ratio: 380 / 720;
    }
  }
</style>
