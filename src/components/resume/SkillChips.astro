---
interface Props {
  skills: { name: string; category: string | null }[];
  /** How many positions use each skill, by lowercase name. */
  usage?: Map<string, number>;
}

const { skills, usage = new Map<string, number>() } = Astro.props;
const usedBy = (name: string) => usage.get(name.toLowerCase()) ?? 0;

const groups = new Map<string, { name: string; category: string | null }[]>();
for (const s of skills) {
  const key = s.category ?? "Other";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(s);
}

const sortedKeys = [...groups.keys()].sort((a, b) =>
  a.localeCompare(b, undefined, { sensitivity: "base" })
);
// Skills I use at work come first, the most used at the front.
for (const items of groups.values()) {
  items.sort(
    (a, b) =>
      usedBy(b.name) - usedBy(a.name) ||
      a.name.localeCompare(b.name, undefined, { sensitivity: "base" })
  );
}
---

{sortedKeys.map((key) => {
  const items = groups.get(key)!;
  return (
    <div class="skill-group">
      <h3 class="skill-group-title">{key}</h3>
      <div class="skill-chips">
        {items.map((s) => (
          <span class="skill-chip" data-used={usedBy(s.name) > 0 || undefined}>
            {s.name}
            {usedBy(s.name) > 0 && (
              <span
                class="skill-uses"
                aria-label={`, used in ${usedBy(s.name)} ${usedBy(s.name) === 1 ? "position" : "positions"}`}
              >
                {usedBy(s.name)}
              </span>
            )}
          </span>
        ))}
      </div>
    </div>
  );
})}

<style>
  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .skill-group-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--badge-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
  }

  /* Skills I use at work stand out and say in how many positions. */
  .skill-chip[data-used] {
    color: var(--text);
    border-color: color-mix(in oklch, var(--accent) 55%, transparent);
    background: color-mix(in oklch, var(--accent) 14%, var(--badge-bg));
    padding-right: 6px;
  }

  .skill-uses {
    min-width: 1.6em;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--card-bg);
    font-size: 0.75rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 280px) {
    .skill-chip {
      padding: 4px 10px;
      overflow-wrap: anywhere;
    }
  }
</style>
