---
import Section from "@/components/utils/Section.astro";
import Fallback from "@/components/utils/Fallback.astro";
import ResumeChapter from "@/components/resume/ResumeChapter.astro";
import HonorCard from "@/components/resume/HonorCard.astro";
import SkillChips from "@/components/resume/SkillChips.astro";
import {
  BriefcaseBusiness,
  GraduationCap,
  Trophy,
  Wrench,
} from "@lucide/astro";
import CareerTimeline from "@/components/charts/CareerTimeline.astro";
import { fetchResume } from "@/lib/data";
import {
  getCareerRows,
  getSkillUsage,
  parseResumeDate,
  tellCareer,
} from "@/lib/stories";
import { applyCache, degradedCache, longLivedCache } from "@/lib/cache";

const resume = await fetchResume().catch(() => null);
applyCache(Astro.response, resume ? longLivedCache : degradedCache);
const hasData = Boolean(
  resume &&
  (resume.positions.length > 0 ||
    resume.education.length > 0 ||
    resume.honors.length > 0 ||
    resume.skills.length > 0)
);

const nowMs = Date.now();
const rows = tellCareer(getCareerRows(resume, nowMs), nowMs);
// Short stints like internships are left out, like on the timeline.
const SHORT_MS = 92 * 24 * 60 * 60 * 1000;
const positions = (resume?.positions ?? []).filter((position) => {
  const start = parseResumeDate(position.startLabel);
  const end = position.isCurrent ? nowMs : parseResumeDate(position.endLabel);
  return Number.isNaN(start) || Number.isNaN(end) || end - start >= SHORT_MS;
});
const openSource = {
  description:
    "I help maintain npmx, forges, bombshell, Nuxt and diglot, as well as the All Contributors ecosystem, and spend a lot of time in the Astro and Starlight repositories.",
  start: "Oct 2023",
};
// Work and open source, newest first.
const chapters = [
  ...positions.map((position) => ({ kind: "work" as const, position })),
  { kind: "open-source" as const, position: undefined },
].toSorted(
  (a, b) =>
    parseResumeDate(b.position?.startLabel ?? openSource.start) -
    parseResumeDate(a.position?.startLabel ?? openSource.start)
);
const firstYear = rows.length
  ? new Date(Math.min(...rows.map((row) => row.start))).getUTCFullYear()
  : undefined;
const firstJob = (resume?.positions ?? [])
  .map((position) => parseResumeDate(position.startLabel))
  .filter((ms) => !Number.isNaN(ms))
  .toSorted((a, b) => a - b)[0];
const usage = getSkillUsage(resume?.positions ?? []);
const numbers = [
  {
    label: "years shipping software",
    value: firstJob
      ? new Date(nowMs).getUTCFullYear() - new Date(firstJob).getUTCFullYear()
      : 0,
  },
  { label: "positions", value: positions.length },
  { label: "skills", value: resume?.skills.length ?? 0 },
  { label: "awards", value: resume?.honors.length ?? 0 },
].filter((number) => number.value > 0);
---

{hasData ? (
  <>
    {numbers.length > 0 && (
      <ul class="resume-numbers">
        {numbers.map((number, index) => (
          <li class="resume-number" style={`--i: ${index}`}>
            <span class="resume-number-value">{number.value}</span>
            <span class="resume-number-label">{number.label}</span>
          </li>
        ))}
      </ul>
    )}

    {rows.length > 0 && firstYear && (
      <Section title="At a glance">
        <CareerTimeline
          label="Work, education and open source over time"
          nowMs={nowMs}
          rows={rows}
          visibleYears={Math.min(
            6,
            new Date(nowMs).getUTCFullYear() - firstYear + 1
          )}
        />
      </Section>
    )}

    <Section title="Experience">
      <BriefcaseBusiness
        slot="leading"
        class="section-icon"
        width={18}
        height={18}
      />
      <ol class="chapters">
        {chapters.map((chapter, index) =>
          chapter.position ? (
            <ResumeChapter
              chips={chapter.position.skills}
              description={chapter.position.description}
              end={chapter.position.endLabel}
              index={index}
              isCurrent={chapter.position.isCurrent}
              kind="work"
              meta={[
                chapter.position.location,
                chapter.position.jobType,
                chapter.position.workplaceType,
              ]}
              organisation={chapter.position.company}
              start={chapter.position.startLabel}
              title={chapter.position.title}
            />
          ) : (
            <ResumeChapter
              description={openSource.description}
              end={null}
              index={index}
              isCurrent
              kind="open-source"
              organisation="On GitHub and Tangled"
              start={openSource.start}
              title="Open source maintainer"
            >
              <a class="button is-small" href="/projects">
                See the projects <span aria-hidden="true">→</span>
              </a>
            </ResumeChapter>
          )
        )}
      </ol>
    </Section>

    {resume!.education.length > 0 && (
      <Section title="Education">
        <GraduationCap
          slot="leading"
          class="section-icon"
          width={18}
          height={18}
        />
        <ol class="chapters">
          {resume!.education.map((education, index) => (
            <ResumeChapter
              description={education.description}
              end={education.endLabel}
              index={index}
              isCurrent={education.isCurrent}
              kind="education"
              meta={[education.grade ? `Grade ${education.grade}` : null]}
              organisation={education.institution}
              start={education.startLabel}
              title={
                [education.degree, education.fieldOfStudy]
                  .filter(Boolean)
                  .join(", ") || education.institution
              }
            />
          ))}
        </ol>
      </Section>
    )}

    {resume!.honors.length > 0 && (
      <Section title="Awards & Honors">
        <Trophy slot="leading" class="section-icon" width={18} height={18} />
        <div class="honor-grid">
          {resume!.honors.map((h) => (
            <HonorCard honor={h} />
          ))}
        </div>
      </Section>
    )}

    {resume!.skills.length > 0 && (
      <Section title="Skills">
        <Wrench slot="leading" class="section-icon" width={18} height={18} />
        <SkillChips skills={resume!.skills} usage={usage} />
      </Section>
    )}
  </>
) : (
  <Fallback
    description="My professional history lives on Sifa, an open profile network on ATproto, and isn't reachable right now."
    fallbackHref="https://sifa.id/p/felixs.dev"
    fallbackLabel="See my Sifa profile"
  />
)}

<style>
  .resume-numbers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: 16px;
    margin-bottom: 56px;
    padding: 0;
    list-style: none;
  }

  .resume-number {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 20px clamp(14px, 4vw, 22px);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card-bg);
  }

  .resume-number-value {
    font-family: var(--font-family-heading);
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .resume-number-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .resume-number {
      animation: resume-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 70ms);
    }
  }

  @keyframes resume-rise {
    from {
      opacity: 0;
      translate: 0 12px;
      filter: blur(6px);
    }
  }

  .section-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .chapters {
    padding: 0;
    list-style: none;
  }

  .honor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .honor-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
