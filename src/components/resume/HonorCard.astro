---
import ExternalIcon from "@/components/utils/ExternalIcon.astro";
import { splitTrailingLink } from "@/lib/stories";

interface Props {
  honor: {
    awardedAt: string | null;
    description: string | null;
    issuer: string | null;
    title: string;
  };
  index: number;
}

const { honor, index } = Astro.props;
const { link, text } = splitTrailingLink(honor.description);
---

<li class="honor" style={`--i: ${index}`}>
  <span class="honor-date">{honor.awardedAt}</span>
  <div class="honor-body">
    {honor.issuer && <span class="honor-issuer">{honor.issuer}</span>}
    <h3 class="honor-title">{honor.title}</h3>
    {text && <p class="honor-text">{text}</p>}
    {link && (
      <a class="button is-small honor-link" href={link.url}>
        {link.host}
        <ExternalIcon />
      </a>
    )}
  </div>
</li>

<style>
  .honor {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 8px 32px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .honor:first-child {
    border-top: 0;
    padding-top: 4px;
  }

  .honor-date {
    color: var(--text);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .honor-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .honor-issuer {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .honor-title {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.25;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .honor-text {
    max-width: 62ch;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .honor-link {
    align-self: flex-start;
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .honor {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .honor {
      animation: honor-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 80ms);
    }
  }

  @keyframes honor-rise {
    from {
      opacity: 0;
      translate: 0 14px;
      filter: blur(6px);
    }
  }
</style>
