---
import PostItem from "@/components/blog/PostItem.astro";

interface Props {
  year: string;
  posts: any[];
}

const { year, posts } = Astro.props;
---

<section class="year-group">
  <div class="year-track" aria-hidden="true">
    <div class="year-depth">
      <div class="year-watermark">{year}</div>
    </div>
  </div>
  <div class="post-list">
    {posts.map((post) => (
      <PostItem post={post} />
    ))}
  </div>
</section>

<style>
  .year-group {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  /* Spans the section, so the space theme's parallax can keep the year
     inside it. Absolutely positioned, its size never depends on the year,
     which lets it be a size container. */
  .year-track {
    position: absolute;
    inset: -60px 0 0 -80px;
    container-type: size;
    z-index: -1;
    pointer-events: none;
  }

  .year-watermark {
    font-family: var(--font-family-mono);
    font-size: 14rem;
    font-weight: 900;
    color: var(--text);
    opacity: 0.07;
    user-select: none;
    line-height: 1;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }
</style>
