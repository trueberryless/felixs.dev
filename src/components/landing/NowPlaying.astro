---
import ActionLink from "@/components/utils/ActionLink.astro";
import Section from "@/components/utils/Section.astro";
import { scrobblerEndpoint, tealProfileUrl } from "@/lib/const";
---

<now-playing data-endpoint={`${scrobblerEndpoint}/api/now-playing`} hidden>
  <Section title="Listening">
    <ActionLink slot="header-actions" href={tealProfileUrl} text="teal.fm" />
    <a class="now-playing-card" data-link href={tealProfileUrl}>
      <img class="cover" data-cover alt="" width="96" height="96" />
      <div class="details">
        <span class="status">
          <span class="pulse" aria-hidden="true"></span>
          <span data-status></span>
        </span>
        <span class="track" data-track></span>
        <span class="artists" data-artists></span>
        <div class="progress" aria-hidden="true">
          <div class="progress-bar" data-progress></div>
        </div>
      </div>
    </a>
  </Section>
</now-playing>

<script>
  const POLL_INTERVAL_MS = 20_000;

  interface NowPlaying {
    isPlaying: boolean;
    playedAt?: string;
    progressMs?: number;
    track?: {
      album: string;
      artists: string[];
      durationMs: number;
      imageUrl?: string;
      name: string;
      url: string;
    };
    updatedAt: string;
  }

  class NowPlayingElement extends HTMLElement {
    #data: NowPlaying | undefined;
    #fetchedAtMs = 0;
    #frame = 0;
    #timer: ReturnType<typeof setInterval> | undefined;

    connectedCallback() {
      void this.#refresh();
      this.#timer = setInterval(() => {
        if (document.visibilityState === "visible") void this.#refresh();
      }, POLL_INTERVAL_MS);
      this.#frame = requestAnimationFrame(() => this.#tick());
    }

    disconnectedCallback() {
      clearInterval(this.#timer);
      cancelAnimationFrame(this.#frame);
    }

    async #refresh() {
      const endpoint = this.dataset.endpoint;
      if (!endpoint) return;

      try {
        const response = await fetch(endpoint);
        if (!response.ok) return;

        this.#data = (await response.json()) as NowPlaying;
        this.#fetchedAtMs = Date.now();
        this.#render();
      } catch {
        // The widget simply stays hidden or stale when the scrobbler is unreachable.
      }
    }

    #render() {
      const track = this.#data?.track;
      if (!this.#data || !track) return;

      this.hidden = false;
      this.classList.toggle("is-playing", this.#data.isPlaying);
      this.#set("[data-track]", track.name);
      this.#set("[data-artists]", track.artists.join(", "));
      this.#set(
        "[data-status]",
        this.#data.isPlaying
          ? "Listening now"
          : `Last played ${formatRelativeTime(this.#data.playedAt)}`
      );

      const link = this.querySelector<HTMLAnchorElement>("[data-link]");
      if (link) link.href = track.url;

      const cover = this.querySelector<HTMLImageElement>("[data-cover]");
      if (cover && track.imageUrl) cover.src = track.imageUrl;
      if (cover) cover.alt = `Cover of ${track.album}`;
    }

    // Moves the progress bar between polls instead of jumping every 20 seconds.
    #tick() {
      const data = this.#data;
      const bar = this.querySelector<HTMLElement>("[data-progress]");
      if (data?.track && bar) {
        const elapsedMs = data.isPlaying ? Date.now() - this.#fetchedAtMs : 0;
        const progressMs = data.isPlaying
          ? (data.progressMs ?? 0) + elapsedMs
          : data.track.durationMs;
        const ratio = Math.min(progressMs / data.track.durationMs, 1);
        bar.style.transform = `scaleX(${ratio})`;
      }

      this.#frame = requestAnimationFrame(() => this.#tick());
    }

    #set(selector: string, text: string) {
      const element = this.querySelector(selector);
      if (element) element.textContent = text;
    }
  }

  function formatRelativeTime(date: string | undefined) {
    if (!date) return "recently";

    const minutes = Math.round((Date.now() - Date.parse(date)) / 60_000);
    const format = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
    if (minutes < 60) return format.format(-minutes, "minute");
    if (minutes < 60 * 24)
      return format.format(-Math.round(minutes / 60), "hour");

    return format.format(-Math.round(minutes / (60 * 24)), "day");
  }

  customElements.define("now-playing", NowPlayingElement);
</script>

<style>
  now-playing {
    display: block;
  }

  now-playing[hidden] {
    display: none;
  }

  .now-playing-card {
    --cover-size: 96px;

    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .now-playing-card:hover {
    background-color: var(--hover-bg);
  }

  .cover {
    flex-shrink: 0;
    width: var(--cover-size);
    height: var(--cover-size);
    border-radius: 8px;
    background: var(--badge-bg);
    object-fit: cover;
  }

  .details {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    height: var(--cover-size);
    min-width: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    line-height: 1;
    font-weight: 500;
    color: var(--text-muted);
  }

  .pulse {
    display: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: pulse 2s infinite;
  }

  .is-playing .pulse {
    display: inline-block;
  }

  .track,
  .artists {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .artists {
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--text-muted);
  }

  .progress {
    flex-shrink: 0;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--border);
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (max-width: 480px) {
    .now-playing-card {
      --cover-size: 80px;

      gap: 14px;
      padding: 14px;
    }

    .details {
      height: auto;
      min-height: var(--cover-size);
      gap: 4px;
    }

    .track {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
