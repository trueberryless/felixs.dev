---
import ActionLink from "@/components/utils/ActionLink.astro";
import Section from "@/components/utils/Section.astro";
import { scrobblerEndpoint, tealProfileUrl } from "@/lib/const";

interface Props {
  actionHref?: string;
  actionText?: string;
  /** Renders only the card, without the section heading around it. */
  bare?: boolean;
  title?: string;
}

const {
  actionHref = "/music",
  actionText = "All stats",
  bare = false,
  title = "Listening",
} = Astro.props;

const Wrapper = bare ? Fragment : Section;
---

<now-playing data-endpoint={`${scrobblerEndpoint}/api/now-playing`} hidden>
  <Wrapper title={title}>
    {!bare && (
      <ActionLink slot="header-actions" href={actionHref} text={actionText} />
    )}
    <a class="now-playing-card" data-link href={tealProfileUrl}>
      <img class="cover" data-cover alt="" width="96" height="96" />
      <div class="details">
        <span class="status">
          <span class="pulse" aria-hidden="true"></span>
          <span data-status></span>
        </span>
        <span class="track" data-track></span>
        <span class="artists" data-artists></span>
        <div class="progress" aria-hidden="true">
          <div class="progress-bar" data-progress></div>
        </div>
      </div>
    </a>
  </Wrapper>
</now-playing>

<script>
  import "@/scripts/now-playing";
</script>

<style>
  now-playing {
    display: block;
  }

  now-playing[hidden] {
    display: none;
  }

  .now-playing-card {
    --cover-size: 96px;

    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .now-playing-card:hover {
    background-color: var(--hover-bg);
  }

  .cover {
    flex-shrink: 0;
    width: var(--cover-size);
    height: var(--cover-size);
    border-radius: 8px;
    background: var(--badge-bg);
    object-fit: cover;
  }

  .details {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    height: var(--cover-size);
    min-width: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    line-height: 1;
    font-weight: 500;
    color: var(--text-muted);
  }

  .pulse {
    display: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: pulse 2s infinite;
  }

  .is-playing .pulse {
    display: inline-block;
  }

  .track,
  .artists {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .artists {
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--text-muted);
  }

  .progress {
    flex-shrink: 0;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--border);
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (max-width: 480px) {
    .now-playing-card {
      --cover-size: 80px;

      gap: 14px;
      padding: 14px;
    }

    .details {
      height: auto;
      min-height: var(--cover-size);
      gap: 4px;
    }

    .track {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }

  /* On a watch, the cover goes on top like in a music player. */
  @media (max-width: 280px) {
    .now-playing-card {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px;
    }

    .cover {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .details {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
