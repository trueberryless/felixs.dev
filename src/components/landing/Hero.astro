import npmxDark from "@/assets/logos/dark/npmx.png";
import nuxtDark from "@/assets/logos/dark/nuxt.png";
import rosePineDark from "@/assets/logos/dark/rose-pine.png";
import starlightDark from "@/assets/logos/dark/starlight.png";
import zizmorDark from "@/assets/logos/dark/zizmor.png";
import astroPrint from "@/assets/logos/planets/astro.png";
import biomePrint from "@/assets/logos/planets/biome.png";
import bombshellPrint from "@/assets/logos/planets/bombshell.png";
import catppuccinPrint from "@/assets/logos/planets/catppuccin.png";
import changesetsPrint from "@/assets/logos/planets/changesets.png";
import diglotPrint from "@/assets/logos/planets/diglot.png";
import e18ePrint from "@/assets/logos/planets/e18e.png";
import expressiveCodePrint from "@/assets/logos/planets/expressive-code.png";
import forgesPrint from "@/assets/logos/planets/forges.png";
import knipPrint from "@/assets/logos/planets/knip.png";
import madeInCommonPrint from "@/assets/logos/planets/made-in-common.png";
import monkeytypePrint from "@/assets/logos/planets/monkeytype.png";
import npmxPrint from "@/assets/logos/planets/npmx.png";
import nuxtPrint from "@/assets/logos/planets/nuxt.png";
import rosePinePrint from "@/assets/logos/planets/rose-pine.png";
import starlightPrint from "@/assets/logos/planets/starlight.png";
import zizmorPrint from "@/assets/logos/planets/zizmor.png";

interface Props {
  name: string;
}

const { name } = Astro.props;

// `depth` places an element between the far sky (0) and the page itself (1).
// Closer elements scroll faster and stack above farther ones, so hexagons are
// listed from far to near and every logo floats in front of the title.
const hexagons = [
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.22,
    left: "52%",
    size: 120,
    top: "25%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.3,
    left: "35%",
    size: 180,
    top: "58%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.36,
    left: "72%",
    size: 220,
    top: "55%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.44,
    left: "65%",
    size: 280,
    top: "-5%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 2,
    depth: 0.48,
    left: "-4%",
    size: 300,
    top: "61%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 3,
    depth: 0.58,
    left: "7%",
    size: 400,
    top: "20%",
  },
];

// The logos start on the corners of a hex grid around the name: five rows
// evenly apart, each half a step off the next. `x` is a share of the width,
// `row` counts rows from the name and `dy` nudges a logo in pixels. The
// script below then spreads them out evenly in the room the actual screen
// leaves, so these spots are only where they start, and where they stay
// without scripts. The projects I work on most are the planets, the smaller
// ones moons, and each group scrolls at its own depth. Phones only show the
// logos with a spot of their own.
const DEPTH = { moon: 0.7, planet: 0.76 };

const planets = [
  {
    dark: starlightDark,
    delay: "-2.2s",
    duration: "6.8s",
    href: "https://starlight.astro.build",
    light: starlightLight,
    name: "Starlight",
    phone: [67, 36],
    planet: "mercury",
    print: starlightPrint,
    spot: { dy: 6, row: -2, x: 37.5 },
  },
  {
    dark: bombshellDark,
    delay: "0s",
    duration: "6s",
    href: "https://bomb.sh",
    light: bombshellLight,
    name: "bombshell",
    phone: [79, 19],
    planet: "jupiter",
    print: bombshellPrint,
    spot: { dy: -6, row: -2, x: 75 },
  },
  {
    dark: astroDark,
    delay: "-4.5s",
    duration: "7.2s",
    href: "https://astro.build",
    light: astroLight,
    name: "Astro",
    phone: [35, 35],
    planet: "mars",
    print: astroPrint,
    spot: { dy: -4, row: -1, x: 30 },
  },
  {
    dark: changesetsDark,
    delay: "-3.6s",
    duration: "6.4s",
    href: "https://changesets.dev",
    light: changesetsLight,
    name: "Changesets",
    phone: [23, 22],
    planet: "saturn",
    print: changesetsPrint,
    spot: { dy: 8, row: -1, x: 82 },
  },
  {
    dark: diglotDark,
    delay: "-4.8s",
    duration: "6.6s",
    href: "https://diglot.sh",
    light: diglotLight,
    name: "diglot",
    phone: [15, 69],
    planet: "venus",
    print: diglotPrint,
    spot: { dy: -6, row: 1, x: 18 },
  },
  {
    dark: npmxDark,
    delay: "-0.8s",
    duration: "5.9s",
    href: "https://npmx.dev",
    light: npmxLight,
    name: "npmx",
    phone: [48, 66],
    planet: "neptune",
    print: npmxPrint,
    spot: { dy: 4, row: 1, x: 70 },
  },
  {
    dark: forgesDark,
    delay: "-1.4s",
    duration: "5.6s",
    href: "https://forges.link",
    light: forgesLight,
    name: "forges",
    phone: [31, 81],
    planet: "uranus",
    print: forgesPrint,
    spot: { dy: 8, row: 2, x: 24.5 },
  },
  {
    dark: madeInCommonDark,
    delay: "-3.1s",
    duration: "5.2s",
    href: "https://made-in-common.dev",
    light: madeInCommonLight,
    name: "Made in Common",
    phone: [82, 70],
    planet: "earth",
    print: madeInCommonPrint,
    spot: { dy: -4, row: 2, x: 62 },
  },
];

const moons = [
  {
    dark: knipDark,
    delay: "-5.3s",
    duration: "7s",
    href: "https://knip.dev",
    hue: 45,
    light: knipLight,
    name: "Knip",
    phone: [50, 14],
    print: knipPrint,
    spot: { dy: -4, row: -2, x: 11.5 },
  },
  {
    dark: rosePineDark,
    delay: "-2.2s",
    duration: "6.8s",
    href: "https://rosepinetheme.com",
    hue: 340,
    light: rosePineLight,
    name: "Rosé Pine",
    print: rosePinePrint,
    spot: { dy: 4, row: -2, x: 88.5 },
  },
  {
    dark: catppuccinDark,
    delay: "0s",
    duration: "6s",
    href: "https://catppuccin.com",
    hue: 305,
    light: catppuccinLight,
    name: "Catppuccin",
    phone: [65, 84],
    print: catppuccinPrint,
    spot: { dy: 6, row: -1, x: 5 },
  },
  {
    dark: biomeDark,
    delay: "-4.5s",
    duration: "7.2s",
    href: "https://biomejs.dev",
    hue: 235,
    light: biomeLight,
    name: "Biome",
    print: biomePrint,
    spot: { dy: -10, row: 0, x: 11 },
  },
  {
    dark: zizmorDark,
    delay: "-3.6s",
    duration: "6.4s",
    href: "https://zizmor.sh",
    hue: 25,
    light: zizmorLight,
    name: "zizmor",
    print: zizmorPrint,
    spot: { dy: 10, row: 0, x: 89 },
  },
  {
    dark: e18eDark,
    delay: "-4.8s",
    duration: "6.6s",
    href: "https://e18e.dev",
    hue: 130,
    light: e18eLight,
    name: "e18e",
    print: e18ePrint,
    spot: { dy: -4, row: 1, x: 95 },
  },
  {
    dark: nuxtDark,
    delay: "-0.8s",
    duration: "5.9s",
    href: "https://nuxt.com",
    hue: 155,
    light: nuxtLight,
    name: "Nuxt",
    print: nuxtPrint,
    spot: { dy: -6, row: 2, x: 11.5 },
  },
  {
    dark: expressiveCodeDark,
    delay: "-1.4s",
    duration: "5.6s",
    href: "https://expressive-code.com",
    hue: 200,
    light: expressiveCodeLight,
    name: "Expressive Code",
    print: expressiveCodePrint,
    spot: { dy: 6, row: 2, x: 49 },
  },
  {
    dark: monkeytypeDark,
    delay: "-3.1s",
    duration: "5.2s",
    href: "https://monkeytype.com",
    hue: 90,
    light: monkeytypeLight,
    name: "Monkeytype",
    print: monkeytypePrint,
    spot: { dy: -2, row: 2, x: 88 },
  },
];

const logos = [
  ...moons.map((moon) =>
    Object.assign({}, moon, { depth: DEPTH.moon, planet: "moon" })
  ),
  ...planets.map((planet) =>
    Object.assign({}, planet, { depth: DEPTH.planet, hue: undefined })
  ),
];

// The space theme turns every logo into a planet with the logo printed on
// its surface. Only a custom property points at the print, so nobody
// downloads it until a stylesheet uses it.
const prints = await Promise.all(
  logos.map((logo) => getImage({ format: "webp", src: logo.print, width: 192 }))
);
---

<section class="hero-viewport" id="hero-section">
  <div class="hexagon-space" aria-hidden="true">
    {hexagons.map((hex, index) => (
      <div
        class="hex-layer parallax"
        style={`top: ${hex.top}; left: ${hex.left}; --depth: ${hex.depth}; z-index: ${index + 1};`}
      >
        <div
          class="hex"
          style={`--size: ${hex.size}px; --b-width: ${hex.borderWidth}px; --b-style: ${hex.borderStyle};`}
        />
      </div>
    ))}
  </div>

  <div class="floating-logos">
    {logos.map((logo, index) => (
      <div
        class:list={[
          "logo-parallax parallax",
          {
            "is-beside": logo.spot.row === 0,
            "is-wide-only": !logo.phone,
          },
        ]}
        style={`--x: ${logo.spot.x}%; --row: ${logo.spot.row}; --dy: ${logo.spot.dy}px;${logo.phone ? ` --phone-x: ${logo.phone[0]}%; --phone-y: ${logo.phone[1]}%;` : ""} --depth: ${logo.depth};`}
      >
        <a
          href={logo.href}
          class:list={["logo-wrapper", { "is-moon": logo.planet === "moon" }]}
          data-planet={logo.planet}
          style={`animation-delay: ${logo.delay}; animation-duration: ${logo.duration}; --planet-print: url(${prints[index]?.src});${logo.hue === undefined ? "" : ` --hue: ${logo.hue};`}`}
          aria-label={logo.name}
        >
          <span class="planet-print" />
          {/* The logos show at about 43px, so they ship small with sharper
              copies for denser screens. */}
          <Image
            src={logo.light}
            alt={`${logo.name} Logo`}
            class="tech-logo light-logo"
            width={52}
            densities={[1, 2, 3]}
          />
          <Image
            src={logo.dark}
            alt={`${logo.name} Logo`}
            class="tech-logo dark-logo"
            width={52}
            densities={[1, 2, 3]}
          />
        </a>
      </div>
    ))}
  </div>
  {/* Hidden until the script below spreads the logos out, so they never jump. */}
  <script is:inline>
    document.currentScript?.previousElementSibling?.setAttribute(
      "data-placing",
      ""
    );
  </script>
  <div class="hero-center-wrapper parallax" style="--depth: 0.65;">
    <div class="hero-halo" aria-hidden="true"></div>
    <h1 class="hero-text">{name}</h1>
  </div>
</section>

<script>
  import { spreadOut, type Obstacle, type Rect } from "@/lib/spread";

  // The logos spread out evenly around the name, like particles pushing each
  // other away, in whatever room this screen and theme leave them. The spots
  // in the markup are where they start, and where they stay without scripts.
  // The name keeps them at a good distance, the header and the edges at a
  // smaller one, so the room towards them gets used too.
  const NAME_SHARE = 0.55;
  const HEADER_SHARE = 0.3;
  // The music dock and the pause button sit at the bottom of the screen.
  const BOTTOM_ROOM = 48;

  let pending = 0;

  function placeAll() {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(() => {
      for (const logos of document.querySelectorAll<HTMLElement>(
        ".floating-logos"
      )) {
        place(logos);
      }
    });
  }

  function place(logos: HTMLElement) {
    const hero = logos.closest<HTMLElement>(".hero-viewport");
    const name = hero?.querySelector(".hero-text");
    if (!hero || !name) return;

    const items = [
      ...logos.querySelectorAll<HTMLElement>(".logo-parallax"),
    ].filter((item) => item.offsetParent !== null);
    const frame = logos.getBoundingClientRect();
    // In the logos' own coordinates, as the page lays out at the very top:
    // the header stays put while scrolling and the name has its parallax.
    const local = (rect: DOMRect, shiftY = 0): Rect => ({
      bottom: rect.bottom - frame.top - shiftY,
      left: rect.left - frame.left,
      right: rect.right - frame.left,
      top: rect.top - frame.top - shiftY,
    });

    const heroBox = local(hero.getBoundingClientRect());
    const box = { ...heroBox, bottom: heroBox.bottom - BOTTOM_ROOM };
    const text = document.createRange();
    text.selectNodeContents(name);
    const wrapper = name.closest(".parallax");
    const lift = wrapper
      ? new DOMMatrix(getComputedStyle(wrapper).transform).m42
      : 0;
    const obstacles: Obstacle[] = [
      { rect: local(text.getBoundingClientRect(), lift), share: NAME_SHARE },
    ];
    const header = document.querySelector(".header-inner");
    if (header) {
      obstacles.push({
        rect: local(header.getBoundingClientRect(), window.scrollY),
        share: HEADER_SHARE,
      });
    }

    // Every layout starts from the spots in the markup, like a fresh load, so
    // a resize ends up exactly where a reload would. The logos briefly go
    // back there without a transition to be measured, then return to where
    // they were, so the move to their new spots still glides.
    const placed = items.map(({ style }) => [style.left, style.top] as const);
    for (const { style } of items) {
      style.transition = "none";
      style.left = "";
      style.top = "";
    }
    const seeds = items.map((item) => ({
      reach: reachOf(item),
      x: item.offsetLeft,
      y: item.offsetTop,
    }));
    for (const [index, { style }] of items.entries()) {
      [style.left, style.top] = placed[index]!;
    }
    void logos.offsetWidth;
    for (const { style } of items) style.transition = "";

    const points = spreadOut(seeds, box, obstacles);
    for (const [index, item] of items.entries()) {
      item.style.left = `${points[index]!.x.toFixed(1)}px`;
      item.style.top = `${points[index]!.y.toFixed(1)}px`;
    }

    if (logos.hasAttribute("data-placing")) {
      logos.removeAttribute("data-placing");
      // Later moves, like a resize or a new theme, glide instead of jumping.
      requestAnimationFrame(() => logos.classList.add("is-placed"));
    }
  }

  // Half a logo plus a little air, and Saturn's rings reach further out.
  function reachOf(item: HTMLElement) {
    const logo = item.querySelector<HTMLElement>(".logo-wrapper");
    if (!logo) return 0;
    const hasRings =
      document.documentElement.classList.contains("space") &&
      logo.dataset.planet === "saturn";
    return (logo.offsetWidth / 2) * (hasRings ? 1.8 : 1) + 12;
  }

  placeAll();
  document.addEventListener("astro:page-load", placeAll);
  window.addEventListener("resize", placeAll, { passive: true });
  void document.fonts.ready.then(placeAll);
  // The space theme sets the name in a wider font.
  new MutationObserver(placeAll).observe(document.documentElement, {
    attributeFilter: ["class"],
  });
</script>

<style is:global>
  /* Specific enough to win over the global padding, whatever order the
     stylesheets end up in. */
  main:has(> #hero-section) {
    padding-top: 0;
    min-height: 0;
  }
</style>

<style>
  .hero-viewport {
    position: relative;
    width: 100vw;
    max-width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .hexagon-space {
    position: absolute;
    width: min(116%, 1400px);
    height: min(116%, 1000px);
    left: calc(50% - min(116%, 1400px) / 2);
    top: calc(50% - min(116%, 1000px) / 2);
    pointer-events: none;
  }

  .hex-layer {
    position: absolute;
  }

  .hex {
    --b-color: var(--text-muted);

    position: relative;
    width: var(--size);
    height: calc(var(--size) * 1.1547);
    background: var(--bg-subtle);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before,
  .hex::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--b-width) * -1);
    right: calc(var(--b-width) * -1);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before {
    transform: rotate(60deg);
  }

  .hex::after {
    transform: rotate(120deg);
  }

  /* The logos keep well clear of the header and of every edge. Rows sit a
     fixed gap apart, within limits, so the closest ones stay well away from
     the name. */
  .floating-logos {
    --gap: clamp(112px, 19%, 150px);

    position: absolute;
    inset: 120px 0;
    width: min(100% - 96px, 1500px);
    height: min(100% - 240px, 860px);
    margin: auto;
    z-index: 40;
    pointer-events: none;
  }

  .floating-logos {
    transition: opacity 0.5s ease;
  }

  /* A fallback reveal, in case the script that places them never runs. */
  .floating-logos[data-placing] {
    opacity: 0;
    animation: logos-reveal 0.5s ease 2s forwards;
  }

  @keyframes logos-reveal {
    to {
      opacity: 1;
    }
  }

  .floating-logos.is-placed .logo-parallax {
    transition:
      left 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :root:not(.dark) .dark-logo {
    display: none;
  }

  :root.dark .light-logo {
    display: none;
  }

  /* Each logo is centred on its spot on the grid. */
  .logo-parallax {
    position: absolute;
    top: calc(50% + var(--row) * var(--gap) + var(--dy));
    left: var(--x);
    translate: -50% -50%;
    pointer-events: auto;
  }

  /* Scroll parallax runs on the compositor: translating by 100vh over
     100vh / speed of scrolling moves an element by speed × scrollY. */
  .parallax {
    --speed: calc(1 - var(--depth));
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .parallax {
        animation: hero-parallax linear both;
        animation-range: 0 calc(100vh / var(--speed));
      }

      /* A separate rule on purpose: minifiers fold a neighbouring
         `animation-timeline` into the `animation` shorthand, which browsers
         reject as a whole. */
      .parallax.parallax {
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes hero-parallax {
    to {
      transform: translate3d(0, 100vh, 0);
    }
  }

  .logo-wrapper {
    --badge-size: 72px;

    width: var(--badge-size);
    height: var(--badge-size);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklch, var(--card-bg) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow:
      0 8px 32px oklch(0.2 0.02 60 / 0.12),
      inset 0 1px 0 oklch(1 0 0 / 0.25);
    animation: floatLogo 6s ease-in-out infinite;
    transition:
      box-shadow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.4s ease;
  }

  :root.dark .logo-wrapper {
    background: oklch(0.24 0.008 250);
    border: 1px solid oklch(0.42 0.01 250);
    box-shadow:
      0 10px 28px oklch(0 0 0 / 0.55),
      0 2px 6px oklch(0 0 0 / 0.5),
      inset 0 1px 0 oklch(1 0 0 / 0.08),
      inset 0 -1px 0 oklch(0 0 0 / 0.4);
  }

  .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0.2 0.02 60 / 0.25),
      inset 0 1px 0 oklch(1 0 0 / 0.4);
    border-color: var(--text-muted);
  }

  :root.dark .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0 0 0 / 0.8),
      0 8px 16px oklch(0 0 0 / 0.6),
      inset 0 1px 0 oklch(1 0 0 / 0.2),
