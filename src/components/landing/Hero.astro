---
import { Image, getImage } from "astro:assets";

import astroLight from "@/assets/logos/light/astro.png";
import biomeLight from "@/assets/logos/light/biome.png";
import bombshellLight from "@/assets/logos/light/bombshell.png";
import catppuccinLight from "@/assets/logos/light/catppuccin.png";
import changesetsLight from "@/assets/logos/light/changesets.png";
import diglotLight from "@/assets/logos/light/diglot.png";
import e18eLight from "@/assets/logos/light/e18e.png";
import expressiveCodeLight from "@/assets/logos/light/expressive-code.png";
import forgesLight from "@/assets/logos/light/forges.png";
import knipLight from "@/assets/logos/light/knip.png";
import madeInCommonLight from "@/assets/logos/light/made-in-common.png";
import monkeytypeLight from "@/assets/logos/light/monkeytype.png";
import npmxLight from "@/assets/logos/light/npmx.png";
import nuxtLight from "@/assets/logos/light/nuxt.png";
import rosePineLight from "@/assets/logos/light/rose-pine.png";
