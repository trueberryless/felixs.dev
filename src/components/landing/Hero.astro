---
import { Image, getImage } from "astro:assets";

import astroLight from "@/assets/logos/light/astro.png";
import astroliciousLight from "@/assets/logos/light/astrolicious.png";
import bombshellLight from "@/assets/logos/light/bombshell.png";
import catppuccinLight from "@/assets/logos/light/catppuccin.png";
import changesetsLight from "@/assets/logos/light/changesets.png";
import diglotLight from "@/assets/logos/light/diglot.png";
import e18eLight from "@/assets/logos/light/e18e.png";
import forgesLight from "@/assets/logos/light/forges.png";
import knipLight from "@/assets/logos/light/knip.png";
import lunariaLight from "@/assets/logos/light/lunaria.png";
import madeInCommonLight from "@/assets/logos/light/made-in-common.png";
import monkeytypeLight from "@/assets/logos/light/monkeytype.png";
import npmxLight from "@/assets/logos/light/npmx.png";
import nuxtLight from "@/assets/logos/light/nuxt.png";
import rosePineLight from "@/assets/logos/light/rose-pine.png";
import singiLabsLight from "@/assets/logos/light/singi-labs.png";
import starlightLight from "@/assets/logos/light/starlight.png";
import zizmorLight from "@/assets/logos/light/zizmor.png";
import astroDark from "@/assets/logos/dark/astro.png";
import astroliciousDark from "@/assets/logos/dark/astrolicious.png";
import bombshellDark from "@/assets/logos/dark/bombshell.png";
import catppuccinDark from "@/assets/logos/dark/catppuccin.png";
import changesetsDark from "@/assets/logos/dark/changesets.png";
import diglotDark from "@/assets/logos/dark/diglot.png";
import e18eDark from "@/assets/logos/dark/e18e.png";
import forgesDark from "@/assets/logos/dark/forges.png";
import knipDark from "@/assets/logos/dark/knip.png";
import lunariaDark from "@/assets/logos/dark/lunaria.png";
import madeInCommonDark from "@/assets/logos/dark/made-in-common.png";
import monkeytypeDark from "@/assets/logos/dark/monkeytype.png";
import npmxDark from "@/assets/logos/dark/npmx.png";
import nuxtDark from "@/assets/logos/dark/nuxt.png";
import rosePineDark from "@/assets/logos/dark/rose-pine.png";
import singiLabsDark from "@/assets/logos/dark/singi-labs.png";
import starlightDark from "@/assets/logos/dark/starlight.png";
import zizmorDark from "@/assets/logos/dark/zizmor.png";
import astroPrint from "@/assets/logos/planets/astro.png";
import astroliciousPrint from "@/assets/logos/planets/astrolicious.png";
import bombshellPrint from "@/assets/logos/planets/bombshell.png";
import catppuccinPrint from "@/assets/logos/planets/catppuccin.png";
import changesetsPrint from "@/assets/logos/planets/changesets.png";
import diglotPrint from "@/assets/logos/planets/diglot.png";
import e18ePrint from "@/assets/logos/planets/e18e.png";
import forgesPrint from "@/assets/logos/planets/forges.png";
import knipPrint from "@/assets/logos/planets/knip.png";
import lunariaPrint from "@/assets/logos/planets/lunaria.png";
import madeInCommonPrint from "@/assets/logos/planets/made-in-common.png";
import monkeytypePrint from "@/assets/logos/planets/monkeytype.png";
import npmxPrint from "@/assets/logos/planets/npmx.png";
import nuxtPrint from "@/assets/logos/planets/nuxt.png";
import rosePinePrint from "@/assets/logos/planets/rose-pine.png";
import singiLabsPrint from "@/assets/logos/planets/singi-labs.png";
import starlightPrint from "@/assets/logos/planets/starlight.png";
import zizmorPrint from "@/assets/logos/planets/zizmor.png";

interface Props {
  name: string;
}

const { name } = Astro.props;

// `depth` places an element between the far sky (0) and the page itself (1).
// Closer elements scroll faster and stack above farther ones, so hexagons are
// listed from far to near and every logo floats in front of the title.
const hexagons = [
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.22,
    left: "52%",
    size: 120,
    top: "25%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.3,
    left: "35%",
    size: 180,
    top: "58%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.36,
    left: "72%",
    size: 220,
    top: "55%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.44,
    left: "65%",
    size: 280,
    top: "-5%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 2,
    depth: 0.48,
    left: "-4%",
    size: 300,
    top: "61%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 3,
    depth: 0.58,
    left: "7%",
    size: 400,
    top: "20%",
  },
];

// The logos float on the corners of a loose triangular grid around the
// name, each row half a step off the next so no four of them line up in a
// rectangle. Spots are percentages of the logo area, a little off the grid
// on purpose. The planets take the rows next to the name, the moons the
// rows further out, and each group scrolls at its own depth. Phones show
// only the logos with a spot of their own, and the two beside the name on
// the edges wait for a wide screen.
const DEPTH = { moon: 0.7, planet: 0.76 };

const planets = [
  {
    at: [79, 71],
    dark: nuxtDark,
    delay: "-2.2s",
    duration: "6.8s",
    href: "https://nuxt.com",
    light: nuxtLight,
    name: "Nuxt",
    phone: [82, 70],
    planet: "earth",
    print: nuxtPrint,
  },
  {
    at: [62, 74],
    dark: npmxDark,
    delay: "0s",
    duration: "6s",
    href: "https://npmx.dev",
    light: npmxLight,
    name: "npmx",
    phone: [48, 66],
    planet: "neptune",
    print: npmxPrint,
  },
  {
    at: [70, 25],
    dark: starlightDark,
    delay: "-4.5s",
    duration: "7.2s",
    href: "https://starlight.astro.build",
    light: starlightLight,
    name: "Starlight",
    phone: [67, 36],
    planet: "mercury",
    print: starlightPrint,
  },
  {
    at: [30, 75],
    dark: forgesDark,
    delay: "-3.6s",
    duration: "6.4s",
    href: "https://forges.link",
    light: forgesLight,
    name: "forges",
    phone: [31, 81],
    planet: "uranus",
    print: forgesPrint,
  },
  {
    at: [22, 26],
    dark: catppuccinDark,
    delay: "-4.8s",
    duration: "6.6s",
    href: "https://catppuccin.com",
    light: catppuccinLight,
    name: "Catppuccin",
    phone: [23, 22],
    planet: "saturn",
    print: catppuccinPrint,
  },
  {
    at: [38, 28],
    dark: astroDark,
    delay: "-0.8s",
    duration: "5.9s",
    href: "https://astro.build",
    light: astroLight,
    name: "Astro",
    phone: [35, 35],
    planet: "mars",
    print: astroPrint,
  },
  {
    at: [14, 72],
    dark: diglotDark,
    delay: "-1.4s",
    duration: "5.6s",
    href: "https://diglot.sh",
    light: diglotLight,
    name: "diglot",
    phone: [15, 69],
    planet: "venus",
    print: diglotPrint,
  },
  {
    at: [87, 29],
    dark: bombshellDark,
    delay: "-3.1s",
    duration: "5.2s",
    href: "https://bomb.sh",
    light: bombshellLight,
    name: "bombshell",
    phone: [79, 19],
    planet: "jupiter",
    print: bombshellPrint,
  },
];

const moons = [
  {
    at: [5, 38],
    dark: rosePineDark,
    delay: "-2.7s",
    duration: "6.2s",
    edge: true,
    href: "https://rosepinetheme.com",
    light: rosePineLight,
    name: "Rosé Pine",
    hue: 340,
    print: rosePinePrint,
  },
  {
    at: [27, 10],
    dark: changesetsDark,
    delay: "-2.2s",
    duration: "6.8s",
    href: "https://github.com/changesets/changesets",
    light: changesetsLight,
    name: "Changesets",
    hue: 240,
    print: changesetsPrint,
  },
  {
    at: [39, 93],
    dark: madeInCommonDark,
    delay: "0s",
    duration: "6s",
    href: "https://made-in-common.dev",
    light: madeInCommonLight,
    name: "Made in Common",
    hue: 60,
    phone: [65, 84],
    print: madeInCommonPrint,
  },
  {
    at: [24, 90],
    dark: e18eDark,
    delay: "-4.5s",
    duration: "7.2s",
    href: "https://e18e.dev",
    light: e18eLight,
    name: "e18e",
    hue: 130,
    print: e18ePrint,
  },
  {
    at: [95, 63],
    dark: lunariaDark,
    delay: "-3.6s",
    duration: "6.4s",
    edge: true,
    href: "https://lunaria.dev",
    light: lunariaLight,
    name: "Lunaria",
    hue: 300,
    print: lunariaPrint,
  },
  {
    at: [80, 8],
    dark: zizmorDark,
    delay: "-4.8s",
    duration: "6.6s",
    href: "https://zizmor.sh",
    light: zizmorLight,
    name: "zizmor",
    hue: 25,
    print: zizmorPrint,
  },
  {
    at: [55, 89],
    dark: singiLabsDark,
    delay: "-0.8s",
    duration: "5.9s",
    href: "https://singi.dev",
    light: singiLabsLight,
    name: "Singi Labs",
    hue: 185,
    print: singiLabsPrint,
  },
  {
    at: [46, 7],
    dark: knipDark,
    delay: "-5.3s",
    duration: "7s",
    href: "https://knip.dev",
    light: knipLight,
    name: "Knip",
    hue: 45,
    phone: [50, 13],
    print: knipPrint,
  },
  {
    at: [63, 11],
    dark: monkeytypeDark,
    delay: "-1.4s",
    duration: "5.6s",
    href: "https://monkeytype.com",
    light: monkeytypeLight,
    name: "Monkeytype",
    hue: 90,
    print: monkeytypePrint,
  },
  {
    at: [72, 92],
    dark: astroliciousDark,
    delay: "-3.1s",
    duration: "5.2s",
    href: "https://github.com/astrolicious",
    light: astroliciousLight,
    name: "Astrolicious",
    hue: 350,
    print: astroliciousPrint,
  },
];

const logos = [
  ...moons.map((moon) =>
    Object.assign({}, moon, { depth: DEPTH.moon, planet: "moon" })
  ),
  ...planets.map((planet) =>
    Object.assign({}, planet, {
      depth: DEPTH.planet,
      edge: false,
      hue: undefined,
    })
  ),
];

// The space theme turns every logo into a planet with the logo printed on
// its surface. Only a custom property points at the print, so nobody
// downloads it until a stylesheet uses it.
const prints = await Promise.all(
  logos.map((logo) => getImage({ format: "webp", src: logo.print, width: 192 }))
);
---

<section class="hero-viewport" id="hero-section">
  <div class="hexagon-space" aria-hidden="true">
    {hexagons.map((hex, index) => (
      <div
        class="hex-layer parallax"
        style={`top: ${hex.top}; left: ${hex.left}; --depth: ${hex.depth}; z-index: ${index + 1};`}
      >
        <div
          class="hex"
          style={`--size: ${hex.size}px; --b-width: ${hex.borderWidth}px; --b-style: ${hex.borderStyle};`}
        />
      </div>
    ))}
  </div>

  <div class="floating-logos">
    {logos.map((logo, index) => (
      <div
        class:list={[
          "logo-parallax parallax",
          { "is-edge": logo.edge, "is-wide-only": !logo.phone },
        ]}
        style={`--x: ${logo.at[0]}%; --y: ${logo.at[1]}%;${logo.phone ? ` --phone-x: ${logo.phone[0]}%; --phone-y: ${logo.phone[1]}%;` : ""} --depth: ${logo.depth};`}
      >
        <a
          href={logo.href}
          class:list={["logo-wrapper", { "is-moon": logo.planet === "moon" }]}
          data-planet={logo.planet}
          style={`animation-delay: ${logo.delay}; animation-duration: ${logo.duration}; --planet-print: url(${prints[index]?.src});${logo.hue === undefined ? "" : ` --hue: ${logo.hue};`}`}
          aria-label={logo.name}
        >
          <span class="planet-print" />
          <Image
            src={logo.light}
            alt={`${logo.name} Logo`}
            class="tech-logo light-logo"
          />
          <Image
            src={logo.dark}
            alt={`${logo.name} Logo`}
            class="tech-logo dark-logo"
          />
        </a>
      </div>
    ))}
  </div>

  <div class="hero-center-wrapper parallax" style="--depth: 0.65;">
    <div class="hero-halo" aria-hidden="true"></div>
    <h1 class="hero-text">{name}</h1>
  </div>
</section>

<style is:global>
  /* Specific enough to win over the global padding, whatever order the
     stylesheets end up in. */
  main:has(> #hero-section) {
    padding-top: 0;
    min-height: 0;
  }
</style>

<style>
  .hero-viewport {
    position: relative;
    width: 100vw;
    max-width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .hexagon-space {
    position: absolute;
    width: min(116%, 1400px);
    height: min(116%, 1000px);
    left: calc(50% - min(116%, 1400px) / 2);
    top: calc(50% - min(116%, 1000px) / 2);
    pointer-events: none;
  }

  .hex-layer {
    position: absolute;
  }

  .hex {
    --b-color: var(--text-muted);

    position: relative;
    width: var(--size);
    height: calc(var(--size) * 1.1547);
    background: var(--bg-subtle);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before,
  .hex::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--b-width) * -1);
    right: calc(var(--b-width) * -1);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before {
    transform: rotate(60deg);
  }

  .hex::after {
    transform: rotate(120deg);
  }

  .floating-logos {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 1180px);
    height: min(100%, 860px);
    transform: translate(-50%, -50%);
    z-index: 40;
    pointer-events: none;
  }

  :root:not(.dark) .dark-logo {
    display: none;
  }

  :root.dark .light-logo {
    display: none;
  }

  /* Each logo is centred on its spot on the ring. */
  .logo-parallax {
    position: absolute;
    top: var(--y);
    left: var(--x);
    translate: -50% -50%;
    pointer-events: auto;
  }

  /* Scroll parallax runs on the compositor: translating by 100vh over
     100vh / speed of scrolling moves an element by speed × scrollY. */
  .parallax {
    --speed: calc(1 - var(--depth));
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .parallax {
        animation: hero-parallax linear both;
        animation-range: 0 calc(100vh / var(--speed));
      }

      /* A separate rule on purpose: minifiers fold a neighbouring
         `animation-timeline` into the `animation` shorthand, which browsers
         reject as a whole. */
      .parallax.parallax {
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes hero-parallax {
    to {
      transform: translate3d(0, 100vh, 0);
    }
  }

  .logo-wrapper {
    --badge-size: 72px;

    width: var(--badge-size);
    height: var(--badge-size);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklch, var(--card-bg) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow:
      0 8px 32px oklch(0.2 0.02 60 / 0.12),
      inset 0 1px 0 oklch(1 0 0 / 0.25);
    animation: floatLogo 6s ease-in-out infinite;
    transition:
      box-shadow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.4s ease;
  }

  :root.dark .logo-wrapper {
    background: oklch(0.24 0.008 250);
    border: 1px solid oklch(0.42 0.01 250);
    box-shadow:
      0 10px 28px oklch(0 0 0 / 0.55),
      0 2px 6px oklch(0 0 0 / 0.5),
      inset 0 1px 0 oklch(1 0 0 / 0.08),
      inset 0 -1px 0 oklch(0 0 0 / 0.4);
  }

  .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0.2 0.02 60 / 0.25),
      inset 0 1px 0 oklch(1 0 0 / 0.4);
    border-color: var(--text-muted);
  }

  :root.dark .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0 0 0 / 0.8),
      0 8px 16px oklch(0 0 0 / 0.6),
      inset 0 1px 0 oklch(1 0 0 / 0.2),
      inset 0 -1px 0 oklch(0 0 0 / 0.4);
    border-color: oklch(0.65 0.01 250);
  }

  .planet-print {
    display: none;
  }

  /* The space theme's styles arrive after the first paint. Until they turn
     the logos into planets, keep them out of sight instead of showing tiles
     that change shape. Kept weak on purpose: after a client-side navigation
     this rule comes after those styles. */
  :where(:root.space) .logo-wrapper {
    opacity: 0;
  }

  .tech-logo {
    width: 60%;
    height: 60%;
    object-fit: contain;
    transition:
      filter 0.4s ease,
      opacity 0.4s ease;
  }

  @keyframes floatLogo {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg) translateZ(0);
    }
    50% {
      transform: translateY(-16px) rotate(3deg) translateZ(0);
    }
  }

  .hero-center-wrapper {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Fades the hexagon lines behind the name. A gradient instead of a backdrop
     blur, which would be recomputed on every frame the hexagons move. */
  .hero-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(90vw, 900px);
    height: 100%;
    min-height: 260px;
    transform: translate(-50%, -50%);
    z-index: 1;
    background: radial-gradient(
      ellipse closest-side,
      var(--bg-subtle) 45%,
      transparent
    );
    pointer-events: none;
  }

  .hero-text {
    position: relative;
    z-index: 2;
    font-size: clamp(3.25rem, 9vw, 8rem);
    line-height: 1.05;
    text-align: center;
    margin: 0;
    padding: 40px clamp(16px, 6vw, 60px);
    color: var(--text);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-text {
      background-image: var(--text-gradient);
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax {
      transform: none !important;
    }

    .logo-wrapper {
      animation: none !important;
      transition: none;
    }

    .logo-wrapper:hover {
      scale: 1;
    }

    .logo-wrapper:hover .tech-logo {
      scale: 1;
      rotate: 0deg;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .logo-wrapper {
      background: var(--bg-subtle);
    }
  }

  @media (max-width: 280px) {
    .hero-text {
      font-size: 15vw;
      padding: 24px 8px;
    }
  }

  /* The moons further out are a little smaller. */
  .logo-wrapper.is-moon {
    --badge-size: 60px;

    border-radius: 14px;
  }

  @media (max-width: 1000px) {
    .logo-parallax.is-edge {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .logo-parallax {
      top: var(--phone-y);
      left: var(--phone-x);
    }

    .logo-parallax.is-wide-only {
      display: none;
    }
  }

  /* No room for the floating logos around the name on a watch. */
  @media (max-width: 280px) {
    .floating-logos {
      display: none;
    }
  }
</style>
