---
import { Image, getImage } from "astro:assets";

import astroLight from "@/assets/logos/light/astro.png";
import npmxLight from "@/assets/logos/light/npmx.png";
import starlightLight from "@/assets/logos/light/starlight.png";
import catppuccinLight from "@/assets/logos/light/catppuccin.png";
import emdashLight from "@/assets/logos/light/emdash-cms.png";
import astroDark from "@/assets/logos/dark/astro.png";
import npmxDark from "@/assets/logos/dark/npmx.png";
import starlightDark from "@/assets/logos/dark/starlight.png";
import catppuccinDark from "@/assets/logos/dark/catppuccin.png";
import emdashDark from "@/assets/logos/dark/emdash-cms.png";
import astroPrint from "@/assets/logos/planets/astro.png";
import catppuccinPrint from "@/assets/logos/planets/catppuccin.png";
import emdashPrint from "@/assets/logos/planets/emdash-cms.png";
import npmxPrint from "@/assets/logos/planets/npmx.png";
import starlightPrint from "@/assets/logos/planets/starlight.png";

interface Props {
  name: string;
}

const { name } = Astro.props;

// `depth` places an element between the far sky (0) and the page itself (1).
// Closer elements scroll faster and stack above farther ones, so hexagons are
// listed from far to near and every logo floats in front of the title.
const hexagons = [
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.22,
    left: "52%",
    size: 120,
    top: "25%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.3,
    left: "35%",
    size: 180,
    top: "58%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 3,
    depth: 0.36,
    left: "72%",
    size: 220,
    top: "55%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 2,
    depth: 0.44,
    left: "65%",
    size: 280,
    top: "-5%",
  },
  {
    borderStyle: "dashed",
    borderWidth: 2,
    depth: 0.48,
    left: "-4%",
    size: 300,
    top: "61%",
  },
  {
    borderStyle: "dotted",
    borderWidth: 3,
    depth: 0.58,
    left: "7%",
    size: 400,
    top: "20%",
  },
];

const logos = [
  {
    dark: astroDark,
    delay: "0s",
    depth: 0.7,
    duration: "6s",
    href: "https://astro.build",
    left: "35%",
    light: astroLight,
    name: "Astro",
    planet: "mars",
    print: astroPrint,
    top: "15%",
  },
  {
    dark: emdashDark,
    delay: "-4.5s",
    depth: 0.72,
    duration: "7.2s",
    href: "https://www.emdashcms.com/",
    left: "77%",
    light: emdashLight,
    name: "EmDash",
    planet: "jupiter",
    print: emdashPrint,
    top: "25%",
  },
  {
    dark: catppuccinDark,
    delay: "-4.8s",
    depth: 0.75,
    duration: "6.6s",
    href: "https://catppuccin.com",
    left: "5%",
    light: catppuccinLight,
    name: "Catppuccin",
    planet: "saturn",
    print: catppuccinPrint,
    top: "35%",
  },
  {
    dark: npmxDark,
    delay: "-1.4s",
    depth: 0.78,
    duration: "5.6s",
    href: "https://npmx.dev",
    left: "57%",
    light: npmxLight,
    name: "npmx",
    planet: "neptune",
    print: npmxPrint,
    top: "75%",
  },
  {
    dark: starlightDark,
    delay: "-3.1s",
    depth: 0.82,
    duration: "5.2s",
    href: "https://starlight.astro.build",
    left: "25%",
    light: starlightLight,
    name: "Starlight",
    planet: "mercury",
    print: starlightPrint,
    top: "80%",
  },
];

// The space theme turns every logo into a planet with the logo printed on
// its surface. Only a custom property points at the print, so nobody
// downloads it until a stylesheet uses it.
const prints = await Promise.all(
  logos.map((logo) => getImage({ format: "webp", src: logo.print, width: 192 }))
);
---

<section class="hero-viewport" id="hero-section">
  <div class="hexagon-space">
    {hexagons.map((hex, index) => (
      <div
        class="hex-layer parallax"
        style={`top: ${hex.top}; left: ${hex.left}; --depth: ${hex.depth}; z-index: ${index + 1};`}
      >
        <div
          class="hex"
          style={`--size: ${hex.size}px; --b-width: ${hex.borderWidth}px; --b-style: ${hex.borderStyle};`}
        />
      </div>
    ))}
  </div>

  <div class="floating-logos">
    {logos.map((logo, index) => (
      <div
        class="logo-parallax parallax"
        style={`top: ${logo.top}; left: ${logo.left}; --depth: ${logo.depth};`}
      >
        <a
          href={logo.href}
          class="logo-wrapper"
          data-planet={logo.planet}
          style={`animation-delay: ${logo.delay}; animation-duration: ${logo.duration}; --planet-print: url(${prints[index]?.src});`}
          aria-label={logo.name}
        >
          <span class="planet-print" />
          <Image
            src={logo.light}
            alt={`${logo.name} Logo`}
            class="tech-logo light-logo"
          />
          <Image
            src={logo.dark}
            alt={`${logo.name} Logo`}
            class="tech-logo dark-logo"
          />
        </a>
      </div>
    ))}
  </div>

  <div class="hero-center-wrapper parallax" style="--depth: 0.65;">
    <div class="hero-halo" aria-hidden="true"></div>
    <h1 class="hero-text">{name}</h1>
  </div>
</section>

<style is:global>
  main {
    padding-top: 0;
    min-height: 0;
  }
</style>

<style>
  .hero-viewport {
    position: relative;
    width: 100vw;
    max-width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .hexagon-space {
    position: absolute;
    width: min(116%, 1400px);
    height: min(116%, 1000px);
    left: calc(50% - min(116%, 1400px) / 2);
    top: calc(50% - min(116%, 1000px) / 2);
    pointer-events: none;
  }

  .hex-layer {
    position: absolute;
  }

  .hex {
    --b-color: var(--text-muted);

    position: relative;
    width: var(--size);
    height: calc(var(--size) * 1.1547);
    background: var(--bg-subtle);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before,
  .hex::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--b-width) * -1);
    right: calc(var(--b-width) * -1);
    box-sizing: border-box;
    border-left: var(--b-width) var(--b-style) var(--b-color);
    border-right: var(--b-width) var(--b-style) var(--b-color);
  }

  .hex::before {
    transform: rotate(60deg);
  }

  .hex::after {
    transform: rotate(120deg);
  }

  .floating-logos {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 1180px);
    height: min(100%, 860px);
    transform: translate(-50%, -50%);
    z-index: 40;
    pointer-events: none;
  }

  :root:not(.dark) .dark-logo {
    display: none;
  }

  :root.dark .light-logo {
    display: none;
  }

  .logo-parallax {
    position: absolute;
    pointer-events: auto;
  }

  /* Scroll parallax runs on the compositor: translating by 100vh over
     100vh / speed of scrolling moves an element by speed × scrollY. */
  .parallax {
    --speed: calc(1 - var(--depth));
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .parallax {
        animation: hero-parallax linear both;
        animation-range: 0 calc(100vh / var(--speed));
      }

      /* A separate rule on purpose: minifiers fold a neighbouring
         `animation-timeline` into the `animation` shorthand, which browsers
         reject as a whole. */
      .parallax.parallax {
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes hero-parallax {
    to {
      transform: translate3d(0, 100vh, 0);
    }
  }

  .logo-wrapper {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklch, var(--card-bg) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow:
      0 8px 32px oklch(0.2 0.02 60 / 0.12),
      inset 0 1px 0 oklch(1 0 0 / 0.25);
    animation: floatLogo 6s ease-in-out infinite;
    transition:
      box-shadow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.4s ease;
  }

  :root.dark .logo-wrapper {
    background: oklch(0.24 0.008 250);
    border: 1px solid oklch(0.42 0.01 250);
    box-shadow:
      0 10px 28px oklch(0 0 0 / 0.55),
      0 2px 6px oklch(0 0 0 / 0.5),
      inset 0 1px 0 oklch(1 0 0 / 0.08),
      inset 0 -1px 0 oklch(0 0 0 / 0.4);
  }

  .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0.2 0.02 60 / 0.25),
      inset 0 1px 0 oklch(1 0 0 / 0.4);
    border-color: var(--text-muted);
  }

  :root.dark .logo-wrapper:hover {
    box-shadow:
      0 24px 48px oklch(0 0 0 / 0.8),
      0 8px 16px oklch(0 0 0 / 0.6),
      inset 0 1px 0 oklch(1 0 0 / 0.2),
      inset 0 -1px 0 oklch(0 0 0 / 0.4);
    border-color: oklch(0.65 0.01 250);
  }

  .planet-print {
    display: none;
  }

  /* The space theme's styles arrive after the first paint. Until they turn
     the logos into planets, keep them out of sight instead of showing tiles
     that change shape. */
  :root.space .logo-wrapper {
    opacity: 0;
  }

  .tech-logo {
    width: 60%;
    height: 60%;
    object-fit: contain;
    transition:
      filter 0.4s ease,
      opacity 0.4s ease;
  }

  @keyframes floatLogo {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg) translateZ(0);
    }
    50% {
      transform: translateY(-16px) rotate(3deg) translateZ(0);
    }
  }

  .hero-center-wrapper {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Fades the hexagon lines behind the name. A gradient instead of a backdrop
     blur, which would be recomputed on every frame the hexagons move. */
  .hero-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(90vw, 900px);
    height: 100%;
    min-height: 260px;
    transform: translate(-50%, -50%);
    z-index: 1;
    background: radial-gradient(
      ellipse closest-side,
      var(--bg-subtle) 45%,
      transparent
    );
    pointer-events: none;
  }

  .hero-text {
    position: relative;
    z-index: 2;
    font-size: clamp(3.25rem, 9vw, 8rem);
    line-height: 1.05;
    text-align: center;
    margin: 0;
    padding: 40px 60px;
    color: var(--text);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-text {
      background-image: var(--text-gradient);
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax {
      transform: none !important;
    }

    .logo-wrapper {
      animation: none !important;
      transition: none;
    }

    .logo-wrapper:hover {
      scale: 1;
    }

    .logo-wrapper:hover .tech-logo {
      scale: 1;
      rotate: 0deg;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .logo-wrapper {
      background: var(--bg-subtle);
    }
  }
</style>
