---
import RadarChart from "@/components/charts/RadarChart.astro";
import Story from "@/components/story/Story.astro";
import { applyCache, dataCache, degradedCache } from "@/lib/cache";
import { actorDid } from "@/lib/const";
import { fetchGitHubActivity } from "@/lib/data";
import { getRepoRecords } from "@/lib/repo";
import { getSocialActivity } from "@/lib/stories";

const [records, github] = await Promise.all([
  getRepoRecords().catch(() => null),
  fetchGitHubActivity(),
]);
applyCache(Astro.response, records ? dataCache : degradedCache);

const activities = records ? getSocialActivity(records, github) : [];
const top = activities.toSorted((a, b) => b.value - a.value)[0];
const hasData = activities.some((activity) => activity.value > 0);
---

<Story
  kicker="Hanging out"
  href={`https://bsky.app/profile/${actorDid}`}
  linkText="Find me on Bluesky"
>
  <Fragment slot="title">
    {top && hasData ? (
      <>
        Mostly <em>{top.doing}</em>
      </>
    ) : (
      "Mostly online"
    )}
  </Fragment>
  <p slot="text">
    What I actually do on Bluesky, GitHub and Tangled, from posts and replies to
    stars and follows.
  </p>
  <div slot="visual">
    {hasData && (
      <RadarChart
        activities={activities}
        label="What I do online, by type of action"
      />
    )}
  </div>
</Story>
