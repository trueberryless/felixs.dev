---
import AreaChart from "@/components/charts/AreaChart.astro";
import Story from "@/components/story/Story.astro";
import { applyCache, degradedCache, longLivedCache } from "@/lib/cache";
import { actorDid } from "@/lib/const";
import { fetchBluesky } from "@/lib/data";
import { getMonthlySeries } from "@/lib/stories";

const posts = await fetchBluesky().catch(() => null);
applyCache(Astro.response, posts ? longLivedCache : degradedCache);

const likesPerMonth = new Map<string, number>();
for (const post of posts ?? []) {
  if (Number.isNaN(Date.parse(post.createdAt))) continue;
  const key = new Date(post.createdAt).toISOString().slice(0, 7);
  likesPerMonth.set(key, (likesPerMonth.get(key) ?? 0) + post.likes);
}
const series = getMonthlySeries(likesPerMonth, Date.now(), 12);
const totalLikes = (posts ?? []).reduce((sum, post) => sum + post.likes, 0);
const favourite = (posts ?? []).toSorted((a, b) => b.likes - a.likes)[0];
---

<Story
  kicker="Talking"
  href={`https://bsky.app/profile/${actorDid}`}
  linkText="Follow me on Bluesky"
>
  <Fragment slot="title">
    {totalLikes > 0 ? (
      <>
        <em>{totalLikes.toLocaleString("en-US")}</em> likes on my last{" "}
        {posts?.length} posts
      </>
    ) : (
      "Mostly on Bluesky"
    )}
  </Fragment>
  <div slot="text" class="talking-text">
    <p>Where I share what I build and what I find on the open social web.</p>
    {favourite && favourite.likes > 0 && (
      <a class="talking-favourite" href={favourite.postUrl}>
        <span class="talking-quote">{favourite.text}</span>
        <span class="talking-likes">♥ {favourite.likes}</span>
      </a>
    )}
  </div>
  <div slot="visual">
    {totalLikes > 0 && (
      <AreaChart points={series} label="Likes on my Bluesky posts per month" />
    )}
  </div>
</Story>

<style>
  .talking-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .talking-favourite {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    color: var(--text);
    transition:
      translate 0.25s ease,
      box-shadow 0.25s ease;
  }

  .talking-favourite:hover {
    translate: 0 -2px;
    box-shadow: var(--lift-shadow);
  }

  .talking-quote {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .talking-likes {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
