---
import Book from "@/components/books/Book.astro";
import Story from "@/components/story/Story.astro";
import { applyCache, dataCache, degradedCache } from "@/lib/cache";
import { loadCached } from "@/lib/data-cache";
import { buildReadingSummary, fetchBooks } from "@/lib/data";

const books = await loadCached("books", fetchBooks, Astro.locals);
applyCache(Astro.response, books ? dataCache : degradedCache);

const summary = books ? buildReadingSummary(books) : null;
const shelf = (books ?? []).slice(0, 4);

const authorCounts = new Map<string, number>();
for (const book of (books ?? []).slice(0, 12)) {
  authorCounts.set(book.authors, (authorCounts.get(book.authors) ?? 0) + 1);
}
const [topAuthor, topAuthorBooks = 0] =
  [...authorCounts].toSorted((a, b) => b[1] - a[1])[0] ?? [];
---

<Story kicker="Reading" href="/books" linkText="Browse the bookshelf">
  <Fragment slot="title">
    {books && books.length > 0 ? (
      <>
        <em>{books.length}</em> books, mostly fantasy
      </>
    ) : (
      "Mostly fantasy"
    )}
  </Fragment>
  <Fragment slot="text">
    {summary && <p>Right now I'm reading {summary.latest.title}.</p>}
    {topAuthor && topAuthorBooks > 1 && (
      <p>Lately a lot of {topAuthor}, apparently.</p>
    )}
  </Fragment>
  <div slot="visual" class="reading-shelf" data-shelf>
    {shelf.map((book) => (
      <div class="reading-book">
        <Book
          title={book.title}
          authors={book.authors}
          coverUrl={book.coverUrl}
          rotation={book.rotation}
          hiveId={book.hiveId}
          thickness={book.thickness}
          compact
        />
      </div>
    ))}
  </div>
</Story>

<style>
  .reading-shelf {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 28px;
  }

  /* A soft pool of shadow instead of a shelf board, so the books stand on
     the page in every theme. */
  .reading-shelf::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 6px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--header-shadow) 70%, transparent),
      transparent
    );
    z-index: -1;
  }

  /* The script below moves the books like the Dock. The whole shelf is the
     hover area, gaps included, so gliding across never drops a book back. */
  @media (hover: hover) and (pointer: fine) and (min-width: 860px) {
    .reading-shelf {
      padding: 48px 32px 28px;
      margin: -48px -32px 0;
    }
  }

  /* A soft light follows the pointer along the shelf. */
  .reading-shelf::before {
    content: "";
    position: absolute;
    left: var(--spot-x, 50%);
    bottom: 0;
    width: 260px;
    height: 220px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklch, var(--accent) 30%, transparent),
      transparent
    );
    opacity: var(--spot, 0);
    pointer-events: none;
    z-index: -1;
  }

  .reading-book {
    position: relative;
    z-index: var(--z, 0);
    margin-inline: 4px;
    zoom: 0.66;
    transform-origin: 50% 100%;
    translate: var(--x, 0px) var(--lift, 0px);
    scale: var(--scale, 1);
    rotate: var(--tilt, 0deg);
  }

  @media (max-width: 600px) {
    .reading-book {
      margin-inline: -10px;
      zoom: 0.48;
    }
  }

  @media (max-width: 280px) {
    .reading-book {
      margin-inline: -16px;
      zoom: 0.36;
    }

    .reading-book:nth-child(n + 4) {
      display: none;
    }
  }
</style>

<script>
  // The shelf works like the Dock. Books near the pointer grow and rise,
  // the one right under it turns towards you, the others slide apart so
  // nothing overlaps and lean away a little, and a soft light follows along.
  // Every value eases on its own spring, so gliding across feels continuous.
  const STIFFNESS = 0.09;
  const DAMPING = 0.74;
  const REACH = 1.3;
  const GROW = 0.3;
  const RISE = 26;
  const LEAN = 5;
  const SPREAD = 0.62;

  type Value = "lift" | "scale" | "tilt" | "x";

  interface ShelfBook {
    current: Record<Value, number>;
    element: HTMLElement;
    link: HTMLElement | null;
    velocity: Record<Value, number>;
  }

  function enableShelf(shelf: HTMLElement) {
    if (shelf.dataset.dock !== undefined) return;
    shelf.dataset.dock = "";

    const books: ShelfBook[] = [
      ...shelf.querySelectorAll<HTMLElement>(".reading-book"),
    ].map((element) => {
      const link = element.querySelector<HTMLElement>(".book-item");
      link?.classList.add("is-steered");
      return {
        current: { lift: 0, scale: 1, tilt: 0, x: 0 },
        element,
        link,
        velocity: { lift: 0, scale: 0, tilt: 0, x: 0 },
      };
    });

    let pointer = 0;
    let presence = 0;
    let presenceTarget = 0;
    let spot = 0;
    let frame = 0;

    const step = () => {
      presence += (presenceTarget - presence) * 0.12;
      const shelfBox = shelf.getBoundingClientRect();
      const zoom = Number(getComputedStyle(books[0]!.element).zoom) || 1;

      // Where each book stands at rest, in screen pixels. Scaling happens
      // around the bottom centre, so only the slide has to be taken out.
      const homes = books.map((book) => {
        const box = book.element.getBoundingClientRect();
        return {
          center: box.left + box.width / 2 - book.current.x * zoom,
          width: box.width / book.current.scale,
        };
      });
      const focus = homes.map(({ center, width }) => {
        const distance = (pointer - center) / width;
        return presence * Math.exp(-(distance * distance) / REACH);
      });
      const grow = focus.map((value) => value * GROW);

      let settled = Math.abs(presenceTarget - presence) < 0.002;
      let lifted = -1;
      books.forEach((book, index) => {
        const { center, width } = homes[index]!;
        const side = Math.sign(center - pointer) || 1;
        // Every growing book pushes the others away from itself.
        const slide = grow.reduce(
          (sum, value, other) =>
            other === index
              ? sum
              : sum + Math.sign(index - other) * value * width * SPREAD,
          0
        );
        const target: Record<Value, number> = {
          lift: -RISE * focus[index]!,
          scale: 1 + grow[index]!,
          tilt:
            side *
            LEAN *
            presence *
            (1 - focus[index]!) *
            Math.min(1, Math.abs(center - pointer) / width),
          x: slide / zoom,
        };
        for (const key of Object.keys(target) as Value[]) {
          book.velocity[key] += (target[key] - book.current[key]) * STIFFNESS;
          book.velocity[key] *= DAMPING;
          book.current[key] += book.velocity[key];
          if (
            Math.abs(book.velocity[key]) > 0.002 ||
            Math.abs(target[key] - book.current[key]) > 0.01
          ) {
            settled = false;
          }
        }
        const style = book.element.style;
        style.setProperty("--x", `${book.current.x.toFixed(2)}px`);
        style.setProperty(
          "--lift",
          `${(book.current.lift / zoom).toFixed(2)}px`
        );
        style.setProperty("--scale", book.current.scale.toFixed(4));
        style.setProperty("--tilt", `${book.current.tilt.toFixed(2)}deg`);
        style.setProperty("--z", String(Math.round(focus[index]! * 10)));
        if (
          focus[index]! > 0.5 &&
          (lifted === -1 || focus[index]! > focus[lifted]!)
        ) {
          lifted = index;
        }
      });
      books.forEach((book, index) =>
        book.link?.classList.toggle("is-lifted", index === lifted)
      );

      spot += (pointer - shelfBox.left - spot) * 0.14;
      shelf.style.setProperty("--spot-x", `${spot.toFixed(1)}px`);
      shelf.style.setProperty("--spot", presence.toFixed(3));

      frame = settled && presenceTarget === 0 ? 0 : requestAnimationFrame(step);
    };
    const wake = () => {
      frame ||= requestAnimationFrame(step);
    };

    shelf.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      if (presenceTarget === 0) {
        spot = event.clientX - shelf.getBoundingClientRect().left;
      }
      pointer = event.clientX;
      presenceTarget = 1;
      wake();
    });
    shelf.addEventListener("pointerleave", () => {
      presenceTarget = 0;
      wake();
    });
    // Moving through the books with the keyboard lifts them the same way.
    shelf.addEventListener("focusin", (event) => {
      const book = (event.target as Element).closest(".reading-book");
      if (!book) return;
      const box = book.getBoundingClientRect();
      pointer = box.left + box.width / 2;
      presenceTarget = 1;
      wake();
    });
    shelf.addEventListener("focusout", () => {
      presenceTarget = 0;
      wake();
    });
  }

  function enableShelves() {
    if (
      !matchMedia("(hover: hover) and (pointer: fine)").matches ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }
    for (const shelf of document.querySelectorAll<HTMLElement>(
      "[data-shelf]"
    )) {
      enableShelf(shelf);
    }
  }
  enableShelves();
  document.addEventListener("astro:page-load", enableShelves);
  // Islands arrive after the page, and the client router swaps the whole
  // body on every navigation, so the watch is on the root.
  new MutationObserver(enableShelves).observe(document.documentElement, {
    childList: true,
    subtree: true,
  });
</script>
