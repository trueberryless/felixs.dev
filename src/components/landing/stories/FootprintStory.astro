---
import BubbleChart from "@/components/charts/BubbleChart.astro";
import Story from "@/components/story/Story.astro";
import { applyCache, degradedCache, longLivedCache } from "@/lib/cache";
import { actorDid } from "@/lib/const";
import { getRepoRecords } from "@/lib/repo";
import { getFootprint } from "@/lib/stories";

const records = await getRepoRecords().catch(() => null);
applyCache(Astro.response, records ? longLivedCache : degradedCache);

const counts = new Map(
  [...(records ?? [])].map(([collection, entries]) => [
    collection,
    entries.length,
  ])
);
const total = [...counts.values()].reduce((sum, count) => sum + count, 0);
const bubbles = getFootprint(counts, { did: actorDid, limit: 18 });
---

<Story
  kicker="Owning"
  href={`https://pdsls.dev/at://${actorDid}`}
  linkText="Explore my repository"
  reverse
>
  <Fragment slot="title">
    {total > 0 ? (
      <>
        <em>{total.toLocaleString("en-US")}</em> records in {counts.size}{" "}
        collections
      </>
    ) : (
      "All of it is mine"
    )}
  </Fragment>
  <p slot="text">
    Everything on this page comes from my own AT Protocol repository: plays,
    posts, books, events, my resume, even chess puzzles. Each bubble is one app
    that writes to it, sized by how many records it keeps there.
  </p>
  <div slot="visual">
    {bubbles.length > 0 && (
      <BubbleChart
        bubbles={bubbles}
        scale="sqrt"
        label={`Records per app in my repository, ${total} in total`}
      />
    )}
  </div>
</Story>
