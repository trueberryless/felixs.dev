---
import Story from "@/components/story/Story.astro";
import { applyCache, dailyCache, degradedCache } from "@/lib/cache";
import { fetchEvents } from "@/lib/data";

const MAX_AVATARS = 8;

const events = await fetchEvents().catch(() => null);
applyCache(Astro.response, events ? dailyCache : degradedCache);

const nowMs = Date.now();
const upcoming = (events ?? [])
  .filter((event) => Date.parse(event.endDate || event.startDate) >= nowMs)
  .toSorted((a, b) => Date.parse(a.startDate) - Date.parse(b.startDate));
const next = upcoming[0];
const dateFormat = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  weekday: "long",
});
const others = next ? Math.max(next.totalAttendees - MAX_AVATARS, 0) : 0;
// How soon the event is decides how to ask: "See you Tuesday?" within the
// week, "See you on November 23?" within the month and "See you in
// January?" after that.
const daysAway = next
  ? (Date.parse(next.startDate) - nowMs) / 86_400_000
  : Number.POSITIVE_INFINITY;
const startDate = next ? new Date(next.startDate) : undefined;
const when = startDate
  ? daysAway < 6
    ? {
        prefix: "",
        text: startDate.toLocaleDateString("en-US", {
          timeZone: "Europe/Vienna",
          weekday: "long",
        }),
      }
    : daysAway < 32
      ? {
          prefix: "on ",
          text: startDate.toLocaleDateString("en-US", {
            day: "numeric",
            month: "long",
            timeZone: "Europe/Vienna",
          }),
        }
      : {
          prefix: "in ",
          text: startDate.toLocaleDateString("en-US", {
            month: "long",
            timeZone: "Europe/Vienna",
          }),
        }
  : undefined;
---

{next && (
  <Story kicker="Meeting" href="/events" linkText="See all events">
    <Fragment slot="title">
      {upcoming.length === 1 ? (
        <>
          See you {when?.prefix}
          <em>{when?.text}</em>?
        </>
      ) : (
        <>
          <em>{upcoming.length}</em> events coming up
        </>
      )}
    </Fragment>
    <p slot="text">Sometimes I go outside and meet people. Come say hi.</p>
    <a slot="visual" class="meeting-card" href={next.atmoUrl}>
      {next.imageUrl && (
        <span class="meeting-cover">
          <img
            class="meeting-backdrop"
            src={next.imageUrl}
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <img
            class="meeting-image"
            src={next.imageUrl}
            alt=""
            loading="lazy"
          />
        </span>
      )}
      <div class="meeting-body">
        <span class="meeting-when">
          {dateFormat.format(new Date(next.startDate))}
        </span>
        <span class="meeting-name">{next.data?.name ?? "Event"}</span>
        {next.locationText && (
          <span class="meeting-where">{next.locationText}</span>
        )}
        {next.attendees.length > 0 && (
          <span class="meeting-people">
            <span class="meeting-avatars">
              {next.attendees.slice(0, MAX_AVATARS).map((avatar, index) => (
                <img
                  src={avatar}
                  alt=""
                  width="34"
                  height="34"
                  loading="lazy"
                  style={`--i: ${index}`}
                />
              ))}
            </span>
            <span class="meeting-going">
              {others > 0 ? `+${others} going` : `${next.totalAttendees} going`}
            </span>
          </span>
        )}
      </div>
    </a>
  </Story>
)}

<style>
  .meeting-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-card) + 4px);
    background: var(--card-bg);
    color: var(--text);
    transition:
      translate 0.3s ease,
      box-shadow 0.3s ease;
  }

  @media (hover: hover) {
    .meeting-card:hover {
      box-shadow: var(--lift-shadow);
      border-color: var(--text-muted);
    }
  }

  /* Covers come in every shape, so the whole image is shown, centred on a
     blurred copy of itself that fills the rest. */
  .meeting-cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .meeting-cover > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .meeting-backdrop {
    object-fit: cover;
    filter: blur(24px) saturate(1.3);
    scale: 1.2;
    opacity: 0.8;
  }

  .meeting-image {
    object-fit: contain;
    transition: scale 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .meeting-card:hover .meeting-image {
      scale: 1.04;
    }
  }

  .meeting-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(14px, 4vw, 24px);
  }

  .meeting-when,
  .meeting-where,
  .meeting-going {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .meeting-name {
    font-family: var(--font-family-heading);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    overflow-wrap: anywhere;
  }

  .meeting-people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 8px;
  }

  .meeting-avatars {
    display: flex;
  }

  .meeting-avatars img {
    width: 34px;
    height: 34px;
    margin-left: -10px;
    border: 2px solid var(--card-bg);
    border-radius: 50%;
    object-fit: cover;
    transition: translate 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 30ms);
  }

  .meeting-avatars img:first-child {
    margin-left: 0;
  }
</style>
