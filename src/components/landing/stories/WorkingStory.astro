---
import CareerTimeline from "@/components/charts/CareerTimeline.astro";
import Story from "@/components/story/Story.astro";
import { applyCache, degradedCache, longLivedCache } from "@/lib/cache";
import { fetchResume } from "@/lib/data";
import { parseResumeDate, type GanttRow } from "@/lib/stories";

const resume = await fetchResume().catch(() => null);
applyCache(Astro.response, resume ? longLivedCache : degradedCache);

const nowMs = Date.now();
const rows: GanttRow[] = [
  ...(resume?.positions ?? []).map((position) => ({
    end: position.isCurrent ? nowMs : parseResumeDate(position.endLabel),
    isCurrent: position.isCurrent,
    kind: "work" as const,
    label: position.company,
    start: parseResumeDate(position.startLabel),
    title: `${position.title} at ${position.company}`,
  })),
  ...(resume?.education ?? []).map((education) => ({
    end: education.isCurrent ? nowMs : parseResumeDate(education.endLabel),
    isCurrent: education.isCurrent,
    kind: "education" as const,
    label: education.institution,
    start: parseResumeDate(education.startLabel),
    title: [education.degree, education.fieldOfStudy, education.institution]
      .filter(Boolean)
      .join(", "),
  })),
]
  .filter((row) => !Number.isNaN(row.start) && !Number.isNaN(row.end))
  .toSorted((a, b) => b.start - a.start);

const job = resume?.positions.find((position) => position.isCurrent);
const study = resume?.education.find((education) => education.isCurrent);
const firstJob = (resume?.positions ?? [])
  .map((position) => parseResumeDate(position.startLabel))
  .filter((ms) => !Number.isNaN(ms))
  .toSorted((a, b) => a - b)[0];
---

<Story kicker="Working" href="/resume" linkText="Read the resume">
  <Fragment slot="title">
    {firstJob ? (
      <>
        Shipping software since <em>{new Date(firstJob).getUTCFullYear()}</em>
      </>
    ) : (
      "Developer and student"
    )}
  </Fragment>
  <p slot="text">
    {job && `${job.title} at ${job.company}`}
    {job && study && ", "}
    {study &&
      `studying ${study.fieldOfStudy ?? study.degree ?? ""} at ${study.institution}`}
    {(job || study) && "."}
  </p>
  <div slot="visual">
    {rows.length > 0 && (
      <CareerTimeline
        rows={rows}
        nowMs={nowMs}
        label="My work and education over time"
      />
    )}
  </div>
</Story>
