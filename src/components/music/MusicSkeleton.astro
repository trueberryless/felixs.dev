---
import MusicBones from "@/components/music/MusicBones.astro";
import NumberCards from "@/components/utils/NumberCards.astro";

// The music page itself, with the same classes, while its stats load.
const ranges = ["4 weeks", "6 months", "12 months", "All time"];
const numbers = ["minutes listened", "plays", "artists", "tracks"];
---

<div class="skeleton ms" aria-hidden="true">
  <div class="ms-ranges">
    <div class="ms-ranges-track">
      {ranges.map((range) => (
        <span class="ms-range">
          <span>{range}</span>
        </span>
      ))}
      <span class="ms-range-toggle">By year</span>
    </div>
  </div>

  <NumberCards numbers={numbers.map((label) => ({ label }))} />

  <section class="ms-section">
    <h2 class="ms-title">Top artists</h2>
    <div class="ms-artists">
      <MusicBones part="artists" />
    </div>
  </section>

  <section class="ms-section">
    <h2 class="ms-title">Top tracks</h2>
    <div class="ms-tracks">
      <MusicBones part="tracks" />
    </div>
  </section>

  <section class="ms-section ms-currents-section">
    <div class="ms-section-head is-row">
      <div class="ms-section-text">
        <h2 class="ms-title">Currents</h2>
        <p class="ms-subtitle">
          How my favourite artists rise and fall over time. Hover an artist to
          follow it.
        </p>
      </div>
    </div>
    <div class="ms-currents">
      <MusicBones part="currents" />
    </div>
  </section>

  <section class="ms-section ms-rhythm">
    <div class="ms-section-head">
      <h2 class="ms-title">Rhythm</h2>
      <p class="ms-subtitle">When I listen, in CET.</p>
    </div>
    <div class="ms-rhythm-grid">
      <div class="ms-clock">
        <MusicBones part="clock" />
      </div>
      <div class="ms-weekdays">
        <MusicBones part="weekdays" />
      </div>
    </div>
  </section>

  <section class="ms-section">
    <div class="ms-section-head">
      <h2 class="ms-title">Every day</h2>
      <p class="ms-subtitle">
        <span class="bone">
          000 plays on 00 days over the last year. Pick a day to see just that
          day.
        </span>
      </p>
    </div>
    <div class="ms-calendar">
      <MusicBones part="calendar" />
    </div>
  </section>

  <section class="ms-section">
    <h2 class="ms-title">Highlights</h2>
    <div class="ms-highlights">
      <MusicBones part="highlights" />
    </div>
  </section>

  <section class="ms-section">
    <div class="ms-section-head">
      <h2 class="ms-title">Recently played</h2>
      <p class="ms-subtitle">
        Every new song joins the track on the right and drifts along as time
        goes by.
      </p>
    </div>
    <div class="ms-recent">
      <MusicBones part="recent" />
    </div>
  </section>
</div>
