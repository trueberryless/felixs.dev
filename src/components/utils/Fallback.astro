---
interface Props {
  description: string;
  fallbackHref: string;
  fallbackLabel: string;
}

const { description, fallbackHref, fallbackLabel } = Astro.props;
---

<div class="fallback">
  <p class="fallback-title">Content unavailable</p>
  <p class="fallback-description">{description}</p>
  <a href={fallbackHref} class="fallback-link button">
    {fallbackLabel}
    <span class="arrow">→</span>
  </a>
</div>

<style>
  .fallback {
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
    background: var(--card-bg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fallback-title {
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
    margin: 0;
  }

  .fallback-description {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .fallback-link {
    align-self: flex-start;
    margin-top: 4px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
</style>
