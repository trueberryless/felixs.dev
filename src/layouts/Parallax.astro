<script>
  // Parallax and the footer reveal run as CSS scroll-driven animations. This
  // fallback only drives them in browsers without scroll timelines, and writes
  // to the moving elements alone: a variable on the root element would restyle
  // the whole page on every scrolled frame.
  const isSupported = CSS.supports("animation-timeline: scroll()");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (!isSupported && !prefersReducedMotion) {
    let layers: { element: HTMLElement; speed: number }[] = [];
    let footer: HTMLElement | null = null;
    let isTicking = false;

    const root = document.documentElement;

    const update = () => {
      // The space theme's pause button stops the parallax as well, and eases
      // everything into place from here.
      const isPaused = root.classList.contains("cosmos-still");
      const scrollY = window.scrollY;
      const maxScroll = root.scrollHeight - window.innerHeight;
      for (const { element, speed } of layers) {
        element.style.transform = isPaused
          ? ""
          : `translate3d(0, ${scrollY * speed}px, 0)`;
      }
      if (footer) {
        footer.style.transform = isPaused
          ? ""
          : `translate3d(0, ${(maxScroll - scrollY) * -0.35}px, 0)`;
      }
      isTicking = false;
    };

    new MutationObserver(update).observe(root, {
      attributes: true,
      attributeFilter: ["class"],
    });

    window.addEventListener(
      "scroll",
      () => {
        if (isTicking) return;
        isTicking = true;
        window.requestAnimationFrame(update);
      },
      { passive: true }
    );
    window.addEventListener("resize", update, { passive: true });

    // The client router renders every page anew, so collect its layers again.
    document.addEventListener("astro:page-load", () => {
      layers = [...document.querySelectorAll<HTMLElement>(".parallax")].map(
        (element) => ({
          element,
          speed:
            1 - Number(getComputedStyle(element).getPropertyValue("--depth")),
        })
      );
      footer = document.querySelector<HTMLElement>(".footer-container");
      update();
    });
  }
</script>
