<script is:inline>
  const setDarkMode = () => {
    let theme = localStorage.getItem("theme");
    const specialThemes = ["space"];
    // Special themes build on a base theme to inherit its assets.
    const baseThemes = { space: "dark" };

    if (!theme) {
      theme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      localStorage.setItem("theme", theme);
    }

    document.documentElement.classList.remove("dark", ...specialThemes);

    if (baseThemes[theme]) {
      document.documentElement.classList.add(baseThemes[theme]);
    }

    if (theme && theme !== "light") {
      document.documentElement.classList.add(theme);
    }
  };

  setDarkMode();
  // The router replaces the root's classes with the next page's, so carry them
  // over before the swap to keep the theme and its scene.
  document.addEventListener("astro:before-swap", (event) => {
    event.newDocument.documentElement.className =
      document.documentElement.className;
  });
  document.addEventListener("astro:after-swap", setDarkMode);
</script>
