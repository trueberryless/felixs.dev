---
import { Moon, Orbit, Sun } from "@lucide/astro";

const links = [
  { label: "Blog", url: "/blog" },
  { label: "Books", url: "/books" },
  { label: "Events", url: "/events" },
  { label: "Projects", url: "/projects" },
  { label: "Resume", url: "/resume" },
];

const firstWordRest = ["e", "l", "i", "x", "\u00A0"];
const secondWordRest = ["c", "h", "n", "e", "i", "d", "e", "r"];

const pathname = Astro.url.pathname;
---

<header class="glass-header">
  <div class="header-inner">
    <div class="pills-wrapper">
      <div class="unified-bg"></div>

      <div class="logo-pill">
        <div class="pill-bg"></div>
        <a href="/" class={pathname === "/" ? "logo active" : "logo"}>
          <span class="initial">F</span>
          <span class="rest">
            <span class="rest-inner">
              {firstWordRest.map((char, i) => (
                <span class="char" style={`--char-index: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          </span>
          <span class="initial">S</span>
          <span class="rest">
            <span class="rest-inner">
              {secondWordRest.map((char, i) => (
                <span class="char" style={`--char-index: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          </span>
          <span class="appendix">
            <span class="appendix-inner">&nbsp;- Home</span>
          </span>
        </a>
      </div>

      <div class="menu-pill">
        <div class="pill-bg"></div>
        <div class="menu-toggle-wrapper">
          <button class="menu-toggle" aria-label="Toggle Menu">
            Menu
          </button>
        </div>

        <nav aria-label="Main Navigation" class="nav-menu">
          <div class="nav-menu-content">
            <ul class="nav-links">
              {links.map((link, i) => {
                const isActive =
                  link.url === "/"
                    ? pathname === "/"
                    : pathname.startsWith(link.url);
                return (
                  <li class="nav-item" style={`--item-index: ${i}`}>
                    <a href={link.url} class={isActive ? "active" : ""}>
                      {link.label}
                    </a>
                  </li>
                );
              })}
              <li
                class="nav-item nav-separator"
                style={`--item-index: ${links.length}`}
                aria-hidden="true"
              ></li>
              <li class="nav-item" style={`--item-index: ${links.length + 1}`}>
                <button
                  id="theme-toggle"
                  class="theme-toggle"
                  aria-label="Switch theme"
                >
                  <span class="theme-text">Light</span>
                  <span class="theme-icon-wrapper" aria-hidden="true">
                    <Sun class="theme-icon sun" width={18} height={18} />
                    <Moon class="theme-icon moon" width={18} height={18} />
                    <Orbit class="theme-icon orbit" width={18} height={18} />
                  </span>
                </button>
              </li>
            </ul>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>
<div
  id="easter-egg-toast"
  class="easter-egg-toast"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<script>
  import { loadCosmos } from "@/scripts/cosmos/load";

  const THEMES = ["light", "dark"];
  const SPECIAL_THEMES: string[] = ["celestial"];
  // Special themes build on a base theme so its assets (logos, shadows) apply.
  const BASE_THEMES: Record<string, string> = { celestial: "dark" };
  const UNLOCK_CLICKS = 7;
  const COUNTDOWN = [
    "T-minus 4… running pre-flight checks",
    "T-minus 3… fasten your seatbelts",
    "T-minus 2… ignition sequence start",
    "T-minus 1… hold on to your snacks",
  ];
  const RELAUNCH_MESSAGES = [
    "Engines on. Next stop: the Atmosphere ✦",
    "Buckle up, we're heading back up ✦",
    "3, 2, 1… liftoff ✦",
    "Back to the stars ✦",
    "Cleared for takeoff ✦",
  ];

  const root = document.documentElement;
  // With the client router this script runs once, while the header is
  // rendered anew on every page, so its elements are looked up per page.
  let button: Element | null = null;
  let headerInner: Element | null = null;
  let header: Element | null = null;
  let themeToggle: HTMLElement | null = null;
  let themeText: Element | null | undefined = null;
  let toast: HTMLElement | null = null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const SCROLL_THRESHOLD_DIVISOR = 1.8;

  let currentTheme = localStorage.getItem("theme") || "light";
  let specialThemesUnlocked =
    SPECIAL_THEMES.length > 0 &&
    localStorage.getItem("specialThemesUnlocked") === "true";
  let clickCount = 0;
  let lastClickTime = 0;
  let toastTimeout: ReturnType<typeof setTimeout> | undefined;
  let isToastVisible = false;
  let isLaunching = false;
  let displayedTheme =
    [...SPECIAL_THEMES, ...THEMES.slice(1)].find((t) =>
      root.classList.contains(t)
    ) ?? "light";

  const showToast = (message: string, duration = 2000) => {
    if (toast) {
      toast.textContent = message;
      toast.classList.add("show");
      isToastVisible = true;
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast?.classList.remove("show");
        isToastVisible = false;
      }, duration);
    }
  };

  const onMenuToggleClick = (event: Event) => {
    event.stopPropagation();

    if (headerInner?.classList.contains("is-open")) {
      headerInner.classList.remove("is-open");
      headerInner.classList.add("is-closing");
      setTimeout(() => {
        headerInner?.classList.remove("is-closing");
      }, 500);
    } else {
      headerInner?.classList.remove("is-closing");
      headerInner?.classList.add("is-open");
    }
  };

  const closeMenu = () => {
    if (!headerInner?.classList.contains("is-open")) return;
    headerInner.classList.remove("is-open");
    headerInner.classList.add("is-closing");
    setTimeout(() => {
      headerInner?.classList.remove("is-closing");
    }, 500);
  };

  document.addEventListener("click", (event) => {
    if (!headerInner?.classList.contains("is-open")) return;
    const target = event.target as Node | null;
    if (target && header?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 600) {
      headerInner?.classList.remove("is-open");
      headerInner?.classList.remove("is-closing");
    }
  });

  const checkScroll = () => {
    const threshold = window.innerHeight / SCROLL_THRESHOLD_DIVISOR;
    if (window.scrollY > threshold) {
      headerInner?.classList.add("is-scrolled");
    } else {
      headerInner?.classList.remove("is-scrolled");
    }
  };

  let isScrolling = false;
  window.addEventListener(
    "scroll",
    () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          checkScroll();
          isScrolling = false;
        });
        isScrolling = true;
      }
    },
    { passive: true }
  );

  const formatTheme = (theme: string) =>
    theme.charAt(0).toUpperCase() + theme.slice(1);

  const syncThemeText = () => {
    const activeTheme =
      [...SPECIAL_THEMES, ...THEMES.slice(1)].find((t) =>
        root.classList.contains(t)
      ) || "light";
    const label = formatTheme(activeTheme);
    if (themeText) themeText.textContent = label;
    themeToggle?.setAttribute("aria-label", `Switch theme (current: ${label})`);
  };

  let switchingFrame = 0;

  const setTheme = (theme: string) => {
    // Without this, every themed element would run its own color transition,
    // which keeps the main thread busy for the whole switch.
    root.classList.add("theme-switching");
    root.classList.remove(...THEMES.slice(1), ...SPECIAL_THEMES);
    const baseTheme = BASE_THEMES[theme];
    if (baseTheme) root.classList.add(baseTheme);
    if (theme !== "light") root.classList.add(theme);
    displayedTheme = theme;
    syncThemeText();

    cancelAnimationFrame(switchingFrame);
    switchingFrame = requestAnimationFrame(() => {
      switchingFrame = requestAnimationFrame(() =>
        root.classList.remove("theme-switching")
      );
    });
  };

  // Every trip to a special theme is a rocket launch; the first one, right
  // after the countdown, gets the long ignition.
  const launchIntoSpace = async (theme: string, isFirstFlight = false) => {
    isLaunching = true;
    const message = isFirstFlight
      ? "Liftoff! Welcome to the Atmosphere ✦"
      : RELAUNCH_MESSAGES[Math.floor(Math.random() * RELAUNCH_MESSAGES.length)];
    showToast(message, isFirstFlight ? 3600 : 3000);

    try {
      const cosmos = await loadCosmos();
      // The launch covers the page with the sky while it switches the theme,
      // so the restyle happens out of sight and needs no view transition.
      await cosmos.launch(toast, () => setTheme(theme), { isFirstFlight });
    } catch {
      setTheme(theme);
    } finally {
      isLaunching = false;
    }
  };

  const applyTheme = (theme: string) => {
    if (theme === displayedTheme) return;
    if (SPECIAL_THEMES.includes(theme)) {
      launchIntoSpace(theme);
      return;
    }
    setTheme(theme);
  };

  const onThemeToggleClick = () => {
    if (isLaunching) return;

    const now = Date.now();
    const isBurst = now - lastClickTime < 400 || isToastVisible;
    clickCount = isBurst ? clickCount + 1 : 1;
    lastClickTime = now;

    if (!specialThemesUnlocked) {
      if (clickCount >= UNLOCK_CLICKS) {
        specialThemesUnlocked = true;
        localStorage.setItem("specialThemesUnlocked", "true");
        currentTheme = SPECIAL_THEMES[0];
        localStorage.setItem("theme", currentTheme);
        launchIntoSpace(currentTheme, true);
        return;
      }
      if (clickCount >= UNLOCK_CLICKS - COUNTDOWN.length) {
        // Warm up the launch pad while the countdown is still running.
        loadCosmos().then((cosmos) => cosmos.prepare());
        showToast(COUNTDOWN[clickCount - (UNLOCK_CLICKS - COUNTDOWN.length)]);
      }
    }

    let availableThemes = [...THEMES];
    if (specialThemesUnlocked) {
      availableThemes = [...availableThemes, ...SPECIAL_THEMES];
    }

    const currentIndex = availableThemes.indexOf(currentTheme);
    currentTheme = availableThemes[(currentIndex + 1) % availableThemes.length];
    localStorage.setItem("theme", currentTheme);

    applyTheme(currentTheme);
  };

  // Fetch the space scene before a click that will need it, so its reveal
  // never waits for the network.
  const prepareNextTheme = () => {
    if (!specialThemesUnlocked) return;
    const availableThemes = [...THEMES, ...SPECIAL_THEMES];
    const nextTheme =
      availableThemes[
        (availableThemes.indexOf(currentTheme) + 1) % availableThemes.length
      ];
    if (SPECIAL_THEMES.includes(nextTheme)) {
      loadCosmos().then((cosmos) => cosmos.prepare());
    }
  };

  const bindPage = () => {
    button = document.querySelector(".menu-toggle");
    headerInner = document.querySelector(".header-inner");
    header = document.querySelector(".glass-header");
    themeToggle = document.getElementById("theme-toggle");
    themeText = themeToggle?.querySelector(".theme-text");
    toast = document.getElementById("easter-egg-toast");
    isToastVisible = false;

    button?.addEventListener("click", onMenuToggleClick);
    themeToggle?.addEventListener("click", onThemeToggleClick);
    themeToggle?.addEventListener("pointerenter", prepareNextTheme);
    themeToggle?.addEventListener("focus", prepareNextTheme);
    syncThemeText();

    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        header?.classList.add("is-ready");
        checkScroll();
      });
    });
  };

  // Fires on the first load and after every client-side navigation.
  document.addEventListener("astro:page-load", bindPage);
</script>

<style>
  .glass-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 16px 24px;
    display: flex;
    justify-content: center;
    --spring-close-height: cubic-bezier(0.33, 0.59, 0.75, 1);
    --spring-close-width: cubic-bezier(0.5, 0, 0.87, 0.52);
    --spring-bouncy: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .glass-header:not(.is-ready) .rest,
  .glass-header:not(.is-ready) .char,
  .glass-header:not(.is-ready) .appendix,
  .glass-header:not(.is-ready) .appendix-inner {
    transition: none !important;
  }

  .header-inner {
    width: 100%;
    max-width: var(--max-width);
    display: flex;
    justify-content: center;
  }

  .pills-wrapper {
    display: flex;
    width: 100%;
    gap: 0;
    position: relative;
    justify-content: space-between;
    align-items: flex-start;
    transition: gap 0.5s var(--spring-close-width) 0s;
  }

  .header-inner.is-open .pills-wrapper {
    gap: 12px;
    transition: gap 0.5s var(--spring-bouncy) 0s;
    animation: squeeze-open 0.6s var(--spring-bouncy) forwards;
  }

  .header-inner.is-closing .pills-wrapper {
    animation: squeeze-close 0.5s var(--spring-close-height) forwards;
  }

  @keyframes squeeze-open {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(0.96);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes squeeze-close {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(0.97);
    }
    100% {
      transform: scale(1);
    }
  }

  .unified-bg,
  .pill-bg {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    background: var(--header-bg);
    --blur-effect: blur(17px) saturate(180%);
    -webkit-backdrop-filter: var(--blur-effect);
    backdrop-filter: var(--blur-effect);
    transform: translateZ(0);
    border: 1px solid var(--border);
    box-shadow: 0 8px 30px var(--header-shadow);
    pointer-events: none;
  }

  .unified-bg {
    z-index: 0;
    opacity: 1;
    transition: opacity 0s 0.5s;
  }

  .pill-bg {
    z-index: 0;
    opacity: 0;
    transition: opacity 0s 0.5s;
  }

  .logo-pill,
  .menu-pill {
    position: relative;
    z-index: 1;
    flex-grow: 1;
    transition: flex-grow 0.5s var(--spring-close-width) 0s;
  }

  .logo-pill {
    padding: 12px 16px 12px 24px;
    display: block;
  }

  .menu-pill {
    padding: 12px 24px 12px 16px;
    display: flex;
    flex-direction: column;
  }

  .logo-pill .pill-bg {
    border-radius: 1.5rem 0 0 1.5rem;
    border-right-width: 0;
    transition:
      border-radius 0.5s var(--spring-close-width) 0s,
      border-width 0.5s var(--spring-close-width) 0s,
      opacity 0s 0.5s;
  }

  .menu-pill .pill-bg {
    border-radius: 0 1.5rem 1.5rem 0;
    border-left-width: 0;
    transition:
      border-radius 0.5s var(--spring-close-width) 0s,
      border-width 0.5s var(--spring-close-width) 0s,
      opacity 0s 0.5s;
  }

  .header-inner.is-open .logo-pill,
  .header-inner.is-open .menu-pill {
    flex-grow: 0;
    padding: 12px 24px;
    transition:
      flex-grow 0.5s var(--spring-bouncy) 0s,
      padding 0.5s var(--spring-bouncy) 0s;
  }

  .header-inner.is-open .unified-bg {
    opacity: 0;
    transition: opacity 0s 0s;
  }

  .header-inner.is-open .pill-bg {
    opacity: 1;
    transition: opacity 0s 0s;
  }

  .header-inner.is-open .logo-pill .pill-bg {
    border-radius: 1.5rem;
    border-right-width: 1px;
    transition:
      border-radius 0.4s var(--spring-bouncy) 0s,
      border-width 0.4s var(--spring-bouncy) 0s,
      opacity 0s 0s;
  }

  .header-inner.is-open .menu-pill .pill-bg {
    border-radius: 1.5rem;
    border-left-width: 1px;
    transition:
      border-radius 0.4s var(--spring-bouncy) 0s,
      border-width 0.4s var(--spring-bouncy) 0s,
      opacity 0s 0s;
  }

  .logo,
  .menu-toggle {
    position: relative;
    z-index: 2;
    line-height: 1.5;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    font-family: inherit;
    display: block;
  }

  .logo {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: var(--text-muted);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .logo.active {
    color: var(--text);
  }

  .rest {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.8s cubic-bezier(0.65, 0, 0.05, 1) 0.15s;
  }

  .rest-inner {
    overflow: hidden;
    min-width: 0;
    display: flex;
    flex-wrap: nowrap;
  }

  .char {
    display: block;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(2px) scale(0.9);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 0.02s);
  }

  .header-inner.is-scrolled .rest {
    grid-template-columns: 1fr;
    transition: grid-template-columns 0.8s cubic-bezier(0.65, 0, 0.05, 1) 0s;
  }

  .header-inner.is-scrolled .char {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0) scale(1);
    transition-delay: calc(0.3s + (var(--char-index) * 0.025s));
  }

  .appendix {
    display: grid;
    grid-template-columns: 1fr;
    transition: grid-template-columns 0.8s cubic-bezier(0.65, 0, 0.05, 1) 0s;
  }

  .appendix-inner {
    overflow: hidden;
    min-width: 0;
    white-space: nowrap;
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.3s;
  }

  .header-inner.is-scrolled .appendix {
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.8s cubic-bezier(0.65, 0, 0.05, 1) 0.15s;
  }

  .header-inner.is-scrolled .appendix-inner {
    opacity: 0;
    transform: translateX(10px);
    transition-delay: 0s;
  }

  .menu-toggle-wrapper {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    width: 100%;
  }

  .menu-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    appearance: none;
    -webkit-appearance: none;
  }

  .nav-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--spring-close-height) 0s;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .nav-menu-content {
    overflow: hidden;
    min-height: 0;
    width: 100%;
  }

  .header-inner.is-open .nav-menu {
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.6s var(--spring-bouncy) 0.1s;
  }

  .nav-links {
    display: flex;
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text);
  }

  .nav-links a:hover {
    transform: translateY(-1px);
  }

  .nav-item {
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 0.2s ease 0s,
      transform 0.4s var(--spring-close-height) 0s;

    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-inner.is-open .nav-item {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.3s ease,
      transform 0.5s var(--spring-bouncy);
    transition-delay: calc(0.2s + (var(--item-index) * 0.05s));
  }

  .nav-separator {
    display: none;
    pointer-events: none;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    gap: 8px;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-icon-wrapper {
    position: relative;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: scale 0.12s ease;
  }

  /* Immediate feedback on press, before the new theme is painted. */
  .theme-toggle:active .theme-icon-wrapper {
    scale: 0.8;
  }

  .theme-icon {
    position: absolute;
    top: 0;
    left: 0;
    width: 18px;
    height: 18px;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.4s ease;
  }

  .theme-icon.sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-icon.moon {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }

  .theme-icon.orbit {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }

  :global(.dark) .theme-icon.sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }

  :global(.dark) .theme-icon.moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.celestial) .theme-icon.sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }

  :global(.celestial) .theme-icon.moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }

  :global(.celestial) .theme-icon.orbit {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .easter-egg-toast {
    position: fixed;
    bottom: 24px;
    max-width: calc(100vw - 136px);
    text-align: center;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--card-bg);
    color: var(--text);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    /* Above the launch sky, since the toast is the launch pad. */
    z-index: 3100;
