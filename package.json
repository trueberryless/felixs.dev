  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "lex build --override && astro build",
    "build:netlify": "lex build --override && ADAPTER_TYPE=netlify astro build",
    "check": "lex build --override && astro check",
    "dev": "lex build --override && astro dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "lint": "oxlint",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/node": "^11.1.14",
    "@astrojs/sitemap": "^3.7.6",
    "@atcute/repo": "^1.1.1",
    "@atproto/lex": "^0.7.0",
    "@lucide/astro": "^1.80.0",
    "@netlify/blobs": "^11.1.11",
    "astro": "^7.4.13",
    "d3-hierarchy": "^3.1.3",
    "sharp": "^0.35.5",
    "simple-icons-astro": "^16.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.1",
    "fontless": "^1.4.0",
    "knip": "^6.48.0",
    "oxlint": "^1.95.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24"
  }
}
